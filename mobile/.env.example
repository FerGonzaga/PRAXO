# URL del servidor de PRAXO (el mismo que usa la página web).
# Copia este archivo como ".env" y cambia el valor.
#
#  - Servidor en Render:            https://TU-APP.onrender.com
#  - Servidor en tu computadora:    http://IP-DE-TU-PC:3000   (ej. http://192.168.1.70:3000)
#    El celular y la PC deben estar en la misma red Wi-Fi. "localhost" NO funciona desde el celular.
EXPO_PUBLIC_API_URL=https://TU-APP.onrender.com
