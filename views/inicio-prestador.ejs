<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>

<body>

  <%- include('partials/navbar') %>

  <main class="container py-5">

    <h1 class="h3 fw-bold mb-1">Hola, <%= usuario.nombre %></h1>
    <p class="text-muted mb-4">Panel de prestador de servicios.</p>

    <div class="row g-4">

      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-bell display-5 text-primary mb-3"></i>
          <h2 class="h5">Solicitudes recibidas</h2>
          <p class="text-muted small">Clientes interesados en tu servicio y el precio de cada trabajo.</p>
          <a href="/prestador/solicitudes" class="btn btn-dark mt-auto">Ver solicitudes</a>
          <a href="/historial" class="btn btn-link btn-sm mt-1">Ver historial completo</a>
        </div>
      </div>

      <!-- NUEVO: precio base del prestador -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-tag display-5 text-primary mb-3"></i>
          <h2 class="h5">Mi precio</h2>
          <p class="text-muted small">Define tu precio base y cámbialo cuando lo necesites.</p>
          <a href="/prestador/precio" class="btn btn-primary mt-auto">Definir precio</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-person-badge display-5 text-primary mb-3"></i>
          <h2 class="h5">Mi perfil</h2>
          <p class="text-muted small">Tus datos y tu información profesional.</p>
          <a href="/perfil" class="btn btn-dark mt-auto">Ver mi perfil</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i id="iconoDisponible" class="bi <%= disponible ? 'bi-toggle-on text-success' : 'bi-toggle-off text-secondary' %> display-5 mb-3"></i>
          <h2 class="h5">Disponibilidad</h2>
          <p class="text-muted small">Marca si estás disponible ahora.</p>
          <div class="mt-auto">
            <div class="form-check form-switch d-inline-flex align-items-center gap-2 fs-5 mb-1">
              <input class="form-check-input" type="checkbox" role="switch" id="switchDisponible" <%= disponible ? 'checked' : '' %>>
              <label class="form-check-label fw-semibold small" for="switchDisponible" id="textoDisponible">
                <%= disponible ? 'Disponible ahora' : 'No disponible' %>
              </label>
            </div>
            <small id="mensajeDisponible" class="d-block text-muted" style="min-height: 1.2em;"></small>
          </div>
        </div>
      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Interruptor de disponibilidad: guarda en el servidor sin recargar la página
    (function () {
      const sw = document.getElementById('switchDisponible');
      const texto = document.getElementById('textoDisponible');
      const icono = document.getElementById('iconoDisponible');
      const msg = document.getElementById('mensajeDisponible');

      function pintar(on) {
        sw.checked = on;
        texto.textContent = on ? 'Disponible ahora' : 'No disponible';
        icono.className = 'bi display-5 mb-3 ' + (on ? 'bi-toggle-on text-success' : 'bi-toggle-off text-secondary');
      }

      sw.addEventListener('change', async () => {
        const deseado = sw.checked;
        sw.disabled = true;
        msg.className = 'd-block text-muted';
        msg.textContent = 'Guardando...';
        try {
          const r = await fetch('/prestador/disponibilidad', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ disponible: deseado })
          });
          const data = await r.json();
          if (!r.ok) throw new Error(data.mensaje || 'No se pudo guardar.');
          pintar(data.disponible);
          msg.className = 'd-block text-success';
          msg.textContent = data.mensaje;
        } catch (e) {
          pintar(!deseado); // revertimos
          msg.className = 'd-block text-danger';
          msg.textContent = e.message || 'Error de conexión.';
        } finally {
          sw.disabled = false;
        }
      });
    })();
  </script>
</body>
</html>
