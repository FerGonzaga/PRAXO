<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= titulo %> - PRAXO
  </title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <!-- Fuente Montserrat de Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">

  <!-- Tu archivo CSS principal -->
  <link rel="stylesheet" href="/css/custom.css">
</head>

<body>

  <!-- NAVBAR (también carga el tema de color praxo-theme.css) -->
  <%- include('partials/navbar') %>


    <!-- LOGIN -->
    <main class="login-wrapper">

      <div class="container">

        <div class="row justify-content-center">

          <div class="col-xl-10 col-xxl-9">

            <div class="login-card">

              <div class="row g-0">


                <!-- PANEL DE MARCA (solo en pantallas grandes) -->
                <aside class="col-lg-5 login-brand d-none d-lg-flex">

                  <img src="/assets/img/logo/logo-praxo-claro.svg" alt="PRAXO" class="login-logo mb-4">

                  <p class="brand-motto mb-3">
                    Find. Connect. Solve.
                  </p>

                  <h2 class="h4 mb-4">
                    Un profesional para cada necesidad
                  </h2>

                  <ul class="list-unstyled mb-0">

                    <li class="mb-3">
                      <i class="bi bi-search me-2"></i>
                      Encuentra profesionales cerca de ti
                    </li>

                    <li class="mb-3">
                      <i class="bi bi-calendar-check me-2"></i>
                      Solicita ahora o programa tu servicio
                    </li>

                    <li>
                      <i class="bi bi-patch-check me-2"></i>
                      Cuentas con correo verificado
                    </li>

                  </ul>

                </aside>


                <!-- PANEL DEL FORMULARIO -->
                <section class="col-lg-7 login-form-panel">

                  <!-- ENCABEZADO -->
                  <div class="mb-4">

                    <!-- Logo visible solo en móvil, donde no se ve el panel de marca -->
                    <img src="/assets/img/logo/logo-praxo.svg" alt="PRAXO" class="login-logo d-lg-none mb-3">

                    <h1 class="h2 fw-bold">
                      Iniciar sesión
                    </h1>

                    <p class="text-muted mb-0">
                      Ingresa a tu cuenta de PRAXO.
                    </p>

                  </div>


                  <!-- MENSAJE -->
                  <div id="mensajeLogin" class="alert d-none" role="alert">
                  </div>


                  <!-- FORMULARIO -->
                  <form id="formLogin" novalidate>

                    <!-- CORREO -->
                    <div class="mb-3">

                      <label for="correoLogin" class="form-label">
                        Correo electrónico
                      </label>

                      <input type="email" class="form-control" id="correoLogin" name="correo"
                        placeholder="ejemplo@correo.com" autocomplete="email" required>

                      <div class="invalid-feedback">
                        Ingresa un correo electrónico válido.
                      </div>

                    </div>


                    <!-- CONTRASEÑA -->
                    <div class="mb-4">

                      <label for="passwordLogin" class="form-label">
                        Contraseña
                      </label>

                      <div class="input-group">

                        <input type="password" class="form-control" id="passwordLogin" name="password"
                          placeholder="Ingresa tu contraseña" autocomplete="current-password" required>

                        <button class="btn btn-outline-secondary" type="button" id="btnMostrarPasswordLogin"
                          aria-label="Mostrar contraseña">
                          <i class="bi bi-eye"></i>
                        </button>

                      </div>

                      <div class="invalid-feedback">
                        Ingresa tu contraseña.
                      </div>

                    </div>


                    <!-- BOTÓN -->
                    <button type="submit" id="btnLogin" class="btn btn-dark w-100">

                      <i class="bi bi-box-arrow-in-right me-2"></i>
                      Iniciar sesión

                    </button>

                  </form>


                  <!-- REGISTRO -->
                  <div class="text-center mt-4">

                    <p class="mb-0 text-muted">
                      ¿No tienes una cuenta?
                      <a href="/registro" class="text-decoration-none fw-semibold">
                        Regístrate
                      </a>
                    </p>

                  </div>

                </section>


              </div>

            </div>

          </div>

        </div>

      </div>

    </main>


    <!-- FOOTER -->
    <%- include('partials/footer') %>


      <!-- Bootstrap JS -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
      </script>

      <!-- JavaScript de autenticación -->
      <script src="/js/auth.js"></script>

      <!-- Aviso cuando llegan desde el enlace del correo de verificación -->
      <script>
        (function () {

          const parametros = new URLSearchParams(window.location.search);

          if (parametros.get('verificado') === '1') {

            const aviso = document.getElementById('mensajeLogin');

            aviso.textContent = '¡Correo verificado! Ya puedes iniciar sesión.';
            aviso.className = 'alert alert-success';

          }

        })();
      </script>

</body>

</html>
