<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4 p-md-5">
            
            <div class="text-center mb-4">
              <i class="bi bi-person-circle display-5"></i>
              <h1 class="h2 fw-bold mt-3">Crear cuenta de cliente</h1>
              <p class="text-muted">Regístrate en PRAXO para encontrar los servicios que necesitas.</p>
            </div>

            <div id="mensajeRegistro" class="alert d-none" role="alert"></div>

            <form id="formRegistro" novalidate>
              <input type="hidden" id="tipoUsuario" name="tipoUsuario" value="cliente">

              <!-- NOMBRE -->
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre completo</label>
                <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Ej. Juan Pérez" minlength="3" required>
                <div class="invalid-feedback">Ingresa tu nombre completo.</div>
              </div>

              <!-- CORREO -->
              <div class="mb-3">
                <label for="correo" class="form-label">Correo electrónico</label>
                <input type="email" class="form-control" id="correo" name="correo" placeholder="ejemplo@correo.com" required>
                <div class="invalid-feedback">Ingresa un correo electrónico válido.</div>
              </div>

              <!-- PASSWORD -->
              <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <div class="input-group">
                  <input type="password" class="form-control" id="password" name="password" placeholder="Mínimo 8 caracteres" minlength="8" required>
                  <button class="btn btn-outline-secondary" type="button" id="btnMostrarPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback">La contraseña debe tener al menos 8 caracteres.</div>
              </div>

              <!-- CONFIRM PASSWORD -->
              <div class="mb-4">
                <label for="confirmPassword" class="form-label">Confirmar contraseña</label>
                <div class="input-group">
                  <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña" minlength="8" required>
                  <button class="btn btn-outline-secondary" type="button" id="btnMostrarConfirmPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback">Las contraseñas deben coincidir.</div>
              </div>

              <!-- ==========================================
                   BOTÓN PARA ABRIR EL POPUP DE TÉRMINOS
              =========================================== -->
              <div class="mb-4">
                <button type="button" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#modalTerminos">
                  <i class="bi bi-file-earmark-text"></i>
                  <span id="textoBotonTerminos">Leer y aceptar Términos y Condiciones</span>
                </button>
                <div id="errorTerminos" class="text-danger small mt-1 d-none text-center fw-bold">
                  <i class="bi bi-exclamation-triangle"></i> Debes abrir y aceptar los términos para continuar.
                </div>
              </div>

              <!-- ==========================================
                   POPUP (MODAL) DE TÉRMINOS Y CONDICIONES
                   ¡Debe estar DENTRO del <form>!
              =========================================== -->
              <div class="modal fade" id="modalTerminos" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                  <div class="modal-content">
                    
                    <!-- Encabezado del Popup -->
                    <div class="modal-header bg-light">
                      <h5 class="modal-title fw-bold">Términos y Condiciones de PRAXO</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    
                    <!-- Cuerpo del Popup (Texto Legal) -->
                    <div class="modal-body text-justify px-4" style="line-height: 1.7; color: #495057;">
                      <h6 class="fw-bold text-dark mt-2">1. Información General y Marco Legal</h6>
                      <p>Los presentes Términos y Condiciones regulan el uso de la plataforma tecnológica PRAXO, en cumplimiento con el Capítulo VIII Bis de la Ley Federal de Protección al Consumidor (LFPC) y la Norma Mexicana NMX-COE-001-SCFI-2018.</p>

                      <h6 class="fw-bold text-dark mt-4">2. Naturaleza de la Plataforma (Intermediación)</h6>
                      <p>PRAXO opera exclusivamente como una plataforma de intermediación (modelo C2C). El contrato de prestación de servicios se celebra única y directamente entre el Cliente y el Prestador. PRAXO no es empleador ni contratista.</p>

                      <h6 class="fw-bold text-dark mt-4">3. Registro y Cuentas</h6>
                      <p>Los usuarios deben proporcionar información veraz. PRAXO se reserva el derecho de suspender cuentas que contengan datos falsos. La protección de estos datos se rige por la Ley Federal de Protección de Datos Personales (LFPDPPP).</p>

                      <h6 class="fw-bold text-dark mt-4">4. Tarifas, Pagos y Garantías</h6>
                      <p>Las tarifas son acordadas directamente entre el Cliente y el Prestador. PRAXO no retiene fondos y no garantiza la calidad, idoneidad o puntualidad de los servicios. Cualquier reclamo deberá resolverse entre las partes.</p>
                      
                      <h6 class="fw-bold text-dark mt-4">5. Cancelaciones y Controversias</h6>
                      <p>De acuerdo con PROFECO, el Cliente tiene derecho a cancelar sin penalización si el Prestador no ha incurrido en gastos. Las controversias podrán someterse a la jurisdicción de la PROFECO en el Estado de Hidalgo.</p>
                    </div>
                    
                    <!-- Footer del Popup (Aquí está el Checkbox) -->
                    <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                      <div class="form-check">
                        <input class="form-check-input border-dark p-2" type="checkbox" id="aceptaTerminos" name="aceptaTerminos" value="true">
                        <label class="form-check-label fw-bold ms-2 mt-1" for="aceptaTerminos" style="cursor: pointer;">
                          Acepto los Términos y Condiciones <span class="text-danger">*</span>
                        </label>
                      </div>
                      <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Listo</button>
                    </div>

                  </div>
                </div>
              </div>

              <!-- BOTON DE REGISTRO -->
              <button type="submit" id="btnRegistro" class="btn btn-dark w-100">
                <i class="bi bi-person-plus me-2"></i> Crear cuenta
              </button>
            </form>

            <div class="text-center mt-4">
              <p class="mb-0 text-muted">¿Ya tienes una cuenta? <a href="/login" class="text-decoration-none">Inicia sesión</a></p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/auth.js"></script>

  <!-- ==========================================
       Script para controlar el Popup de Términos
  =========================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('formRegistro');
      const checkboxTerminos = document.getElementById('aceptaTerminos');
      const errorTerminos = document.getElementById('errorTerminos');
      const textoBoton = document.getElementById('textoBotonTerminos');

      // Escuchar cuando el usuario marca o desmarca el checkbox dentro del popup
      checkboxTerminos.addEventListener('change', function() {
        if(this.checked) {
          textoBoton.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Términos aceptados</span>';
          errorTerminos.classList.add('d-none');
        } else {
          textoBoton.textContent = 'Leer y aceptar Términos y Condiciones';
        }
      });

      // Validar el formulario justo antes de enviarlo a Node.js
      form.addEventListener('submit', function(evento) {
        if (!checkboxTerminos.checked) {
          evento.preventDefault(); // Detenemos el envío
          errorTerminos.classList.remove('d-none'); // Mostramos la alerta roja
          
          // Abrimos el popup automáticamente para que lo acepte
          const modal = new bootstrap.Modal(document.getElementById('modalTerminos'));
          modal.show();
        }
      });
    });
  </script>

</body>
</html>