<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Quiénes somos - PRAXO</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >
</head>

<body>

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>


  <!-- HERO -->
  <section class="bg-dark text-white">
    <div class="container-fluid p-0">
      <div class="row g-0 align-items-center">

        <!-- TEXTO -->
        <div class="col-lg-6 p-5">
          <div class="container">

            <p class="text-uppercase fw-semibold mb-2">
              Conoce PRAXO
            </p>

            <h1 class="display-3 fw-bold">
              Quiénes somos
            </h1>

            <p class="lead mt-4">
              Conectamos a personas que necesitan un servicio
              con profesionales capaces de ayudarles.
            </p>

            <a href="/trabajadores" class="btn btn-light btn-lg mt-3">
              Explorar servicios
              <i class="bi bi-arrow-right ms-2"></i>
            </a>

          </div>
        </div>

        <!-- IMAGEN -->
        <div class="col-lg-6">
          <img
            src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=1200&q=80"
            class="img-fluid w-100"
            alt="Profesional realizando un servicio"
            style="height: 500px; object-fit: cover;"
          >
        </div>

      </div>
    </div>
  </section>


  <!-- QUIÉNES SOMOS -->
  <section class="container py-5">

    <div class="row align-items-center g-5">

      <!-- IMAGEN -->
      <div class="col-lg-6">

        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1000&q=80"
          class="img-fluid rounded-4 shadow"
          alt="Profesional trabajando"
        >

      </div>


      <!-- TEXTO -->
      <div class="col-lg-6">

        <p class="text-uppercase fw-semibold text-secondary mb-2">
          Nuestra plataforma
        </p>

        <h2 class="display-6 fw-bold mb-4">
          ¿Qué es PRAXO?
        </h2>

        <p class="lead">
          PRAXO es una plataforma digital diseñada para facilitar
          la búsqueda y conexión entre clientes y profesionales
          de distintos oficios y servicios.
        </p>

        <p class="text-muted">
          A través de nuestra plataforma, los usuarios pueden
          encontrar profesionales de acuerdo con el servicio que
          necesitan y su ubicación.
        </p>

        <p class="text-muted">
          Nuestro propósito es hacer que encontrar ayuda para una
          necesidad cotidiana sea un proceso sencillo, accesible
          y eficiente.
        </p>

      </div>

    </div>

  </section>


  <!-- MISIÓN Y VISIÓN -->
  <section class="bg-light py-5">

    <div class="container">

      <div class="text-center mb-5">

        <p class="text-uppercase fw-semibold text-secondary">
          Nuestro propósito
        </p>

        <h2 class="display-6 fw-bold">
          Lo que nos impulsa
        </h2>

      </div>


      <div class="row g-4">

        <!-- MISIÓN -->
        <div class="col-md-6">

          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-5">

              <div class="mb-4">
                <span class="fs-1">
                  <i class="bi bi-bullseye"></i>
                </span>
              </div>

              <h3 class="fw-bold mb-3">
                Nuestra misión
              </h3>

              <p class="text-muted mb-0">
                Facilitar la conexión entre personas que necesitan
                un servicio y profesionales que pueden ofrecerlo,
                proporcionando una plataforma sencilla y accesible
                para encontrar y contactar servicios de manera
                eficiente.
              </p>

            </div>
          </div>

        </div>


        <!-- VISIÓN -->
        <div class="col-md-6">

          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-5">

              <div class="mb-4">
                <span class="fs-1">
                  <i class="bi bi-eye"></i>
                </span>
              </div>

              <h3 class="fw-bold mb-3">
                Nuestra visión
              </h3>

              <p class="text-muted mb-0">
                Ser una plataforma que facilite el acceso a servicios
                profesionales y contribuya a generar nuevas
                oportunidades para quienes ofrecen sus conocimientos
                y habilidades.
              </p>

            </div>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- CÓMO TRABAJAMOS -->
  <section class="container py-5">

    <div class="text-center mb-5">

      <p class="text-uppercase fw-semibold text-secondary">
        PRAXO
      </p>

      <h2 class="display-6 fw-bold">
        ¿Cómo ayudamos?
      </h2>

      <p class="text-muted">
        Hacemos que encontrar un profesional sea más sencillo.
      </p>

    </div>


    <div class="row text-center g-4">

      <!-- BUSCAR -->
      <div class="col-md-4">

        <div class="p-4">

          <div class="mb-3">
            <i class="bi bi-search fs-1"></i>
          </div>

          <h3 class="h4 fw-bold">
            Busca
          </h3>

          <p class="text-muted">
            Encuentra el servicio que necesitas y consulta
            profesionales disponibles.
          </p>

        </div>

      </div>


      <!-- COMPARAR -->
      <div class="col-md-4">

        <div class="p-4">

          <div class="mb-3">
            <i class="bi bi-person-check fs-1"></i>
          </div>

          <h3 class="h4 fw-bold">
            Elige
          </h3>

          <p class="text-muted">
            Revisa los perfiles de los profesionales y conoce
            la información disponible sobre sus servicios.
          </p>

        </div>

      </div>


      <!-- CONTACTAR -->
      <div class="col-md-4">

        <div class="p-4">

          <div class="mb-3">
            <i class="bi bi-chat-dots fs-1"></i>
          </div>

          <h3 class="h4 fw-bold">
            Contacta
          </h3>

          <p class="text-muted">
            Ponte en contacto con el profesional y acuerda
            los detalles del servicio.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- VALORES -->
  <section class="bg-dark text-white py-5">

    <div class="container">

      <div class="text-center mb-5">

        <p class="text-uppercase fw-semibold text-white-50">
          Nuestra esencia
        </p>

        <h2 class="display-6 fw-bold">
          Lo que representa PRAXO
        </h2>

      </div>


      <div class="row g-4 text-center">

        <!-- CONFIANZA -->
        <div class="col-md-4">

          <i class="bi bi-shield-check display-4"></i>

          <h3 class="h4 mt-3">
            Confianza
          </h3>

          <p class="text-white-50">
            Buscamos facilitar relaciones claras entre
            clientes y profesionales.
          </p>

        </div>


        <!-- ACCESIBILIDAD -->
        <div class="col-md-4">

          <i class="bi bi-globe2 display-4"></i>

          <h3 class="h4 mt-3">
            Accesibilidad
          </h3>

          <p class="text-white-50">
            Queremos que encontrar un servicio sea
            sencillo y accesible para todos.
          </p>

        </div>


        <!-- CONEXIÓN -->
        <div class="col-md-4">

          <i class="bi bi-people display-4"></i>

          <h3 class="h4 mt-3">
            Conexión
          </h3>

          <p class="text-white-50">
            Acercamos a quienes necesitan un servicio
            con quienes pueden ofrecerlo.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="container py-5">

    <div class="row justify-content-center">

      <div class="col-lg-10">

        <div class="bg-light rounded-4 p-5 text-center">

          <i class="bi bi-tools display-5"></i>

          <h2 class="display-6 fw-bold mt-3">
            Encuentra el profesional que necesitas
          </h2>

          <p class="lead text-muted">
            Descubre los servicios disponibles en PRAXO.
          </p>

          <a href="/trabajadores" class="btn btn-dark btn-lg">
            Buscar un servicio
            <i class="bi bi-search ms-2"></i>
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- FOOTER -->
  <%- include('partials/footer') %>


  <!-- Bootstrap JavaScript -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>

</body>
</html>
```
