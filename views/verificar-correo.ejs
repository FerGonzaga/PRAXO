<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Encuentra tu Servicio</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6">

        <h1 class="h3 mb-2">Verificación de correo</h1>
        <p class="text-muted mb-4">
          Página de prueba: envía un código a tu correo y valídalo.
        </p>

        <!-- Paso 1: pedir el codigo -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="h6">1. Envía el código</h2>
            <div class="mb-2">
              <input type="text" id="nombre" class="form-control" placeholder="Tu nombre">
            </div>
            <div class="mb-2">
              <input type="email" id="correo" class="form-control" placeholder="tucorreo@ejemplo.com">
            </div>
            <button id="btnEnviar" class="btn btn-primary">Enviar código</button>
          </div>
        </div>

        <!-- Paso 2: escribir el codigo recibido -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="h6">2. Escribe el código recibido</h2>
            <div class="mb-2">
              <input
                type="text"
                id="codigo"
                class="form-control"
                placeholder="123456"
                maxlength="6"
                inputmode="numeric"
              >
            </div>
            <button id="btnValidar" class="btn btn-success">Validar código</button>
          </div>
        </div>

        <div id="mensaje"></div>

      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const mensajeDiv = document.getElementById('mensaje');

    function mostrar(tipo, texto) {
      mensajeDiv.innerHTML = `<div class="alert alert-${tipo}">${texto}</div>`;
    }

    async function llamar(url, datos) {
      const respuesta = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(datos),
      });
      return respuesta.json();
    }

    document.getElementById('btnEnviar').addEventListener('click', async () => {
      mostrar('secondary', 'Enviando código...');
      try {
        const resultado = await llamar('/verificacion/enviar', {
          nombre: document.getElementById('nombre').value,
          correo: document.getElementById('correo').value,
        });
        mostrar(resultado.ok ? 'success' : 'danger', resultado.mensaje);
      } catch (error) {
        mostrar('danger', 'No se pudo conectar con el servidor.');
      }
    });

    document.getElementById('btnValidar').addEventListener('click', async () => {
      mostrar('secondary', 'Validando...');
      try {
        const resultado = await llamar('/verificacion/validar', {
          correo: document.getElementById('correo').value,
          codigo: document.getElementById('codigo').value,
        });
        mostrar(resultado.ok ? 'success' : 'danger', resultado.mensaje);
      } catch (error) {
        mostrar('danger', 'No se pudo conectar con el servidor.');
      }
    });
  </script>
</body>
</html>
