<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>

<body>

  <%- include('partials/navbar') %>

  <main class="container py-5">

    <h1 class="h3 fw-bold mb-1">Hola, <%= usuario.nombre %></h1>
    <p class="text-muted mb-4">¿Qué quieres hacer hoy?</p>

    <div class="row g-4">
<!-- ========================================== -->
<!-- 🟢 SECCIÓN DE MIS SERVICIOS Y ACCESO AL CHAT -->
<!-- ========================================== -->
<div class="container py-4">
  <h2 class="fw-bold mb-4"><i class="bi bi-journal-check me-2"></i> Mis Servicios Solicitados</h2>

  <% if (typeof solicitudes !== 'undefined' && solicitudes.length > 0) { %>
    <div class="row g-4">
      <% solicitudes.forEach(solicitud => { %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <% const coloresEstado = { Pendiente: 'warning text-dark', Cotizada: 'success', Aceptada: 'info text-dark', Rechazada: 'secondary', Pagada: 'primary', Completada: 'dark' }; %>
              <span class="badge bg-<%= coloresEstado[solicitud.estado] || 'primary' %> px-3 py-2 rounded-pill">
                Estado: <%= solicitud.estado %>
              </span>
              <small class="text-muted"><%= new Date(solicitud.fechaCreacion).toLocaleDateString() %></small>
            </div>

            <h5 class="fw-bold"><%= solicitud.servicio %></h5>
            <p class="text-muted mb-2"><strong>Prestador:</strong> <%= solicitud.trabajadorId && solicitud.trabajadorId.usuarioId ? solicitud.trabajadorId.usuarioId.nombre : 'Profesional PRAXO' %></p>
            <p class="text-muted mb-3"><strong>Ubicación:</strong> <%= solicitud.ubicacion %></p>

            <!-- Si el prestador ya cotizó, le avisamos al cliente aquí mismo -->
            <% if (solicitud.estado === 'Cotizada') { %>
              <div class="alert alert-success py-2 px-3 small mb-3">
                <i class="bi bi-cash-coin me-1"></i> <strong>¡Cotización lista!</strong> Total: <%= tarifas.formatoMXN(tarifas.desgloseDeSolicitud(solicitud).total) %> MXN <span class="text-muted">(incluye comisión e IVA)</span>
              </div>
            <% } %>

            <% if (solicitud.estado === 'Aceptada') { %>
              <div class="alert alert-info py-2 px-3 small mb-2">
                <i class="bi bi-hourglass-split me-1"></i> <strong>Pago pendiente:</strong> <%= tarifas.formatoMXN(tarifas.desgloseDeSolicitud(solicitud).total) %> MXN
              </div>
              <a href="/pago/<%= solicitud._id %>" class="btn btn-success w-100 mb-2 fw-bold"><i class="bi bi-credit-card me-1"></i> Pagar ahora</a>
            <% } %>
            <% if (solicitud.estado === 'Pagada') { %>
              <div class="alert alert-primary py-2 px-3 small mb-3">
                <i class="bi bi-check-circle-fill me-1"></i> <strong>Pagado.</strong> Ref: <%= solicitud.pago && solicitud.pago.referencia %>
              </div>
            <% } %>
            <% if ((solicitud.estado === 'Pagada' || solicitud.estado === 'Completada') && solicitud.pago && solicitud.pago.referencia) { %>
              <a href="/pago/<%= solicitud._id %>/comprobante" target="_blank" class="btn btn-outline-primary w-100 mb-2">
                <i class="bi bi-file-earmark-pdf me-1"></i> Ver comprobante de pago
              </a>
            <% } %>

            <% if (solicitud.estado === 'Completada') { %>
              <div class="alert alert-warning py-2 px-3 small mb-3">
                <i class="bi bi-star-fill me-1"></i> <strong>Servicio completado.</strong> Entra al chat para calificarlo.
              </div>
            <% } %>

            <!-- Botón para entrar a la Sala de Acuerdos -->
            <a href="/chat/<%= solicitud._id %>" class="btn btn-dark w-100">
              <i class="bi bi-chat-dots-fill me-1"></i> 
              <%= solicitud.estado === 'Cotizada' ? 'Ver Cotización y Chat' : 'Abrir Chat del Servicio' %>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
      <i class="bi bi-bag-x fs-1 text-muted"></i>
      <h5 class="mt-3 fw-bold">No tienes solicitudes activas</h5>
      <p class="text-muted">Explora los profesionales y solicita un servicio para comenzar.</p>
      <a href="/trabajadores" class="btn btn-dark mt-2">Buscar profesionales</a>
    </div>
  <% } %>
</div>

      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-search display-5 text-primary mb-3"></i>
          <h2 class="h5">Buscar un servicio</h2>
          <p class="text-muted small">Encuentra profesionales cerca de ti.</p>
          <a href="/trabajadores" class="btn btn-dark mt-auto">Buscar</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-clock-history display-5 text-primary mb-3"></i>
          <h2 class="h5">Mis solicitudes</h2>
          <p class="text-muted small">Revisa los servicios que has pedido.</p>
          <a href="/carrito" class="btn btn-outline-dark mt-auto">Ver mis servicios</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-clock-history display-5 text-primary mb-3"></i>
          <h2 class="h5">Historial</h2>
          <p class="text-muted small">Todos tus servicios, pagos y comprobantes.</p>
          <a href="/historial" class="btn btn-outline-dark mt-auto">Ver historial</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-person-gear display-5 text-primary mb-3"></i>
          <h2 class="h5">Mi perfil</h2>
          <p class="text-muted small">Consulta tus datos de cuenta.</p>
          <a href="/perfil" class="btn btn-outline-dark mt-auto">Ver perfil</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <i class="bi bi-shield-lock display-5 text-primary mb-3"></i>
          <h2 class="h5">Privacidad</h2>
          <p class="text-muted small">Tu consentimiento y tus derechos ARCO.</p>
          <a href="/perfil/privacidad" class="btn btn-outline-dark mt-auto">Centro de privacidad</a>
        </div>
      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>