<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    body { background-color: #f4f7f6; }
    .tarjeta-preview {
      background: linear-gradient(135deg, #1e293b, #0d6efd);
      color: #fff; border-radius: 16px; padding: 22px; min-height: 190px;
      box-shadow: 0 10px 25px rgba(13,110,253,.25); font-family: monospace;
    }
    .tarjeta-preview .numero { font-size: 1.35rem; letter-spacing: 2px; margin: 28px 0 18px; }
    .tarjeta-preview small { opacity: .7; font-family: system-ui, sans-serif; font-size: .7rem; text-transform: uppercase; }
    .resumen-card { border-radius: 16px; }
    .total { font-size: 1.8rem; }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-10">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="fw-bold mb-0"><i class="bi bi-shield-lock-fill text-primary me-2"></i> Pago seguro</h3>
          <a href="/chat/<%= solicitud._id %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver al chat</a>
        </div>

        <div class="alert alert-warning small d-flex align-items-start gap-2">
          <i class="bi bi-cone-striped fs-5"></i>
          <div>
            <strong>Modo simulación:</strong> no se realiza ningún cargo real ni se guardan datos de tu tarjeta.
            Usa <code>4242 4242 4242 4242</code> (aprobada) o <code>4000 0000 0000 0002</code> (rechazada), cualquier fecha futura y cualquier CVV.
          </div>
        </div>

        <div class="row g-4">

          <!-- RESUMEN DEL SERVICIO -->
          <div class="col-md-5 order-md-2">
            <div class="card resumen-card border-0 shadow-sm p-4">
              <h5 class="fw-bold mb-3">Resumen</h5>
              <p class="mb-1"><strong>Servicio:</strong> <%= solicitud.servicio %></p>
              <p class="mb-1"><strong>Prestador:</strong> <%= solicitud.trabajadorId ? solicitud.trabajadorId.nombre : 'Profesional PRAXO' %></p>
              <% if (solicitud.fecha) { %>
                <p class="mb-1"><strong>Fecha:</strong> <%= solicitud.fecha %> <%= solicitud.hora || '' %></p>
              <% } %>
              <p class="mb-3"><strong>Ubicación:</strong> <%= solicitud.ubicacion %></p>
              <% if (solicitud.mensajeCotizacion) { %>
                <p class="small text-muted fst-italic mb-3">"<%= solicitud.mensajeCotizacion %>"</p>
              <% } %>
              <hr>
              <% const d = tarifas.desgloseDeSolicitud(solicitud); %>
              <%- include('partials/desglose', { d, rol: 'cliente' }) %>
              <p class="small text-muted mt-3 mb-0">
                <i class="bi bi-receipt me-1"></i> Al pagar recibirás un comprobante en PDF como garantía de tu compra.
              </p>
            </div>
          </div>

          <!-- FORMULARIO DE TARJETA -->
          <div class="col-md-7 order-md-1">
            <div class="card border-0 shadow-sm rounded-4 p-4">

              <div class="tarjeta-preview mb-4">
                <div class="d-flex justify-content-between">
                  <i class="bi bi-cpu fs-3"></i>
                  <span id="prevMarca" class="fw-bold">TARJETA</span>
                </div>
                <div class="numero" id="prevNumero">•••• •••• •••• ••••</div>
                <div class="d-flex justify-content-between">
                  <div><small>Titular</small><div id="prevTitular">NOMBRE APELLIDO</div></div>
                  <div class="text-end"><small>Vence</small><div id="prevVence">MM/AA</div></div>
                </div>
              </div>

              <% if (error) { %>
                <div class="alert alert-danger"><i class="bi bi-exclamation-octagon-fill me-1"></i> <%= error %></div>
              <% } %>

              <form action="/pago/<%= solicitud._id %>" method="POST" id="formPago" novalidate autocomplete="off">
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="numero">Número de tarjeta</label>
                  <input type="text" inputmode="numeric" class="form-control form-control-lg" id="numero" name="numero"
                         placeholder="1234 5678 9012 3456" maxlength="23" required value="<%= datos.numero || '' %>">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="titular">Nombre del titular</label>
                  <input type="text" class="form-control" id="titular" name="titular" placeholder="Como aparece en la tarjeta" required value="<%= datos.titular || '' %>">
                </div>
                <div class="row g-3 mb-4">
                  <div class="col-6">
                    <label class="form-label fw-semibold" for="vencimiento">Vencimiento</label>
                    <input type="text" inputmode="numeric" class="form-control" id="vencimiento" name="vencimiento" placeholder="MM/AA" maxlength="5" required value="<%= datos.vencimiento || '' %>">
                  </div>
                  <div class="col-6">
                    <label class="form-label fw-semibold" for="cvv">CVV</label>
                    <input type="password" inputmode="numeric" class="form-control" id="cvv" name="cvv" placeholder="123" maxlength="4" required>
                  </div>
                </div>

                <div id="errorCliente" class="alert alert-danger d-none"></div>

                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold" id="btnPagar">
                  <i class="bi bi-lock-fill me-1"></i> Pagar <%= tarifas.formatoMXN(tarifas.desgloseDeSolicitud(solicitud).total) %> MXN
                </button>
                <p class="text-center text-muted small mt-3 mb-0"><i class="bi bi-shield-check me-1"></i> Pago protegido por PRAXO</p>
              </form>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const numero = $('numero'), titular = $('titular'), venc = $('vencimiento'), cvv = $('cvv');

      function marca(n) {
        if (/^4/.test(n)) return 'VISA';
        if (/^(5[1-5]|2[2-7])/.test(n)) return 'MASTERCARD';
        if (/^3[47]/.test(n)) return 'AMEX';
        return 'TARJETA';
      }
      function luhn(n) {
        let s = 0, d = false;
        for (let i = n.length - 1; i >= 0; i--) {
          let x = +n[i]; if (d) { x *= 2; if (x > 9) x -= 9; } s += x; d = !d;
        }
        return s % 10 === 0;
      }

      function actualizar() {
        const n = numero.value.replace(/\D/g, '').slice(0, 19);
        numero.value = n.replace(/(.{4})/g, '$1 ').trim();
        $('prevNumero').textContent = (n + '•'.repeat(Math.max(0, 16 - n.length))).replace(/(.{4})/g, '$1 ').trim();
        $('prevMarca').textContent = marca(n);
        $('prevTitular').textContent = titular.value.toUpperCase() || 'NOMBRE APELLIDO';
        $('prevVence').textContent = venc.value || 'MM/AA';
      }

      numero.addEventListener('input', actualizar);
      titular.addEventListener('input', actualizar);
      venc.addEventListener('input', () => {
        let v = venc.value.replace(/\D/g, '').slice(0, 4);
        if (v.length > 2) v = v.slice(0, 2) + '/' + v.slice(2);
        venc.value = v;
        actualizar();
      });
      cvv.addEventListener('input', () => { cvv.value = cvv.value.replace(/\D/g, '').slice(0, 4); });
      actualizar();

      $('formPago').addEventListener('submit', (e) => {
        const n = numero.value.replace(/\D/g, '');
        let msg = '';
        if (n.length < 13 || !luhn(n)) msg = 'El número de tarjeta no es válido.';
        else if (titular.value.trim().length < 3) msg = 'Escribe el nombre del titular.';
        else if (!/^\d{2}\/\d{2}$/.test(venc.value)) msg = 'La fecha debe tener el formato MM/AA.';
        else if (cvv.value.length < 3) msg = 'Revisa el CVV.';

        if (msg) {
          e.preventDefault();
          $('errorCliente').textContent = msg;
          $('errorCliente').classList.remove('d-none');
          return;
        }
        const btn = $('btnPagar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Procesando pago...';
      });
    })();
  </script>
</body>
</html>
