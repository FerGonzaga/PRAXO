<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- CSS general de PRAXO -->
  <link rel="stylesheet" href="/css/custom.css">
  
  <style>
    body { background-color: #f6f7f9; }
    .carrito-encabezado { padding-top: 45px; padding-bottom: 20px; }
    .carrito-encabezado h1 { font-weight: 700; color: #212529; }
    .carrito-encabezado p { color: #6c757d; margin-bottom: 0; }
    
    .carrito-vacio {
      background-color: #ffffff;
      border-radius: 20px;
      padding: 70px 25px;
      text-align: center;
      box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
    }
    .carrito-vacio-icono {
      width: 90px; height: 90px;
      margin: 0 auto 25px;
      border-radius: 50%;
      background-color: #f1f3f5;
      display: flex; align-items: center; justify-content: center;
      font-size: 40px; color: #212529;
    }
    
    .servicio-card {
      background-color: #ffffff;
      border: none;
      border-radius: 18px;
      padding: 25px;
      margin-bottom: 18px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .servicio-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 7px 24px rgba(0, 0, 0, 0.09);
    }
    .servicio-icono {
      width: 55px; height: 55px;
      border-radius: 14px;
      background-color: #212529; color: #ffffff;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; flex-shrink: 0;
    }
    .servicio-titulo { font-size: 20px; font-weight: 700; margin-bottom: 5px; }
    .prestador { color: #6c757d; margin-bottom: 18px; }
    
    .dato-servicio { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 10px; color: #495057; }
    .dato-servicio i { margin-top: 2px; color: #6c757d; width: 18px; }
    
    .descripcion-servicio {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 12px;
      background-color: #f8f9fa;
      color: #495057;
    }
    .descripcion-servicio p { margin-bottom: 0; }
    
    /* 🟢 NUEVOS ESTILOS PARA EVIDENCIA Y BADGES */
    .evidencia-img {
      width: 100px;
      height: 100px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid #dee2e6;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .evidencia-img:hover { opacity: 0.8; }
    .badge-urgencia { background-color: #dc3545; color: white; padding: 6px 10px; border-radius: 6px; font-weight: 600; font-size: 12px; }
    .badge-cotizacion { background-color: #0d6efd; color: white; padding: 6px 10px; border-radius: 6px; font-weight: 600; font-size: 12px; }
    
    .estado-pendiente {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 12px; border-radius: 50px;
      background-color: #fff3cd; color: #856404;
      font-size: 13px; font-weight: 600;
    }
    
    .btn-eliminar {
      border: 1px solid #dc3545; background-color: transparent; color: #dc3545;
      border-radius: 9px; padding: 8px 13px; transition: 0.2s ease;
    }
    .btn-eliminar:hover { background-color: #dc3545; color: white; }
    
    .resumen-carrito {
      background-color: #ffffff; border-radius: 18px; padding: 25px;
      margin-top: 28px; margin-bottom: 50px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }
    .resumen-numero {
      width: 45px; height: 45px; border-radius: 50%;
      background-color: #212529; color: #ffffff;
      display: flex; align-items: center; justify-content: center; font-weight: 700;
    }
    
    @media (max-width: 767px) {
      .servicio-card { padding: 20px; }
      .acciones-servicio { margin-top: 20px; }
      .resumen-acciones { flex-direction: column; width: 100%; }
      .resumen-acciones form, .resumen-acciones a, .resumen-acciones button { width: 100%; }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="container">
    <!-- ENCABEZADO -->
    <section class="carrito-encabezado">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <h1 class="mb-2"><i class="bi bi-bag-check me-2"></i> Mis servicios</h1>
          <p>Revisa los servicios que deseas contratar antes de continuar.</p>
        </div>
        <div>
          <a href="/trabajadores" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i> Seguir buscando
          </a>
        </div>
      </div>
    </section>

    <!-- CARRITO VACIO -->
    <% if (!carrito || carrito.length === 0) { %>
      <section class="carrito-vacio">
        <div class="carrito-vacio-icono"><i class="bi bi-bag"></i></div>
        <h2 class="h4 fw-bold mb-3">Aún no tienes servicios seleccionados</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
          Explora los profesionales disponibles en PRAXO y selecciona el servicio que necesitas.
        </p>
        <a href="/trabajadores" class="btn btn-dark px-4 py-2">
          <i class="bi bi-search me-2"></i> Buscar profesionales
        </a>
      </section>
    <% } else { %>

      <!-- SERVICIOS DEL CARRITO -->
      <% const fmt = tarifas.formatoMXN; %>
      <% if (error === 'politicas') { %>
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i> Para confirmar debes aceptar las políticas de compra.</div>
      <% } %>
      <div id="avisoCarrito"></div>

      <section id="listaServicios">
        <% carrito.forEach((item) => { %>
          <article class="servicio-card" id="item-<%= item.id %>"
                   data-id="<%= item.id %>"
                   data-fecha="<%= item.fecha %>" data-hora="<%= item.hora %>"
                   data-ubicacion="<%= item.ubicacion %>" data-referencias="<%= item.referenciasUbicacion || '' %>"
                   data-descripcion="<%= item.descripcion %>" data-urgencia="<%= item.urgencia %>"
                   data-cotizacion="<%= item.requiereCotizacion ? '1' : '0' %>"
                   data-prestador="<%= item.estimado ? item.estimado.precioPrestador : '' %>"
                   data-comision="<%= item.estimado ? item.estimado.comision : '' %>"
                   data-iva="<%= item.estimado ? item.estimado.ivaComision : '' %>"
                   data-total="<%= item.estimado ? item.estimado.total : '' %>">
            <div class="row align-items-start">

              <!-- INFORMACION -->
              <div class="col-md-9">
                <div class="d-flex gap-3">
                  <div class="servicio-icono"><i class="bi bi-tools"></i></div>

                  <div class="flex-grow-1">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                      <h2 class="servicio-titulo mb-0"><%= item.servicio %></h2>
                      <span class="badge-urgencia js-badge-urgencia <%= item.urgencia === 'Urgencia' ? '' : 'd-none' %>"><i class="bi bi-exclamation-triangle-fill me-1"></i> Emergencia</span>
                      <span class="badge-cotizacion js-badge-cotizacion <%= item.requiereCotizacion ? '' : 'd-none' %>"><i class="bi bi-cash-coin me-1"></i> Requiere Cotización</span>
                    </div>

                    <div class="prestador">
                      <i class="bi bi-person-circle me-1"></i> Prestador: <strong><%= item.trabajador %></strong>
                    </div>

                    <div class="row">
                      <div class="col-sm-6">
                        <div class="dato-servicio">
                          <i class="bi bi-calendar-event"></i>
                          <div><strong>Fecha:</strong> <span class="js-fecha"><%= new Date(item.fecha + 'T00:00:00').toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' }) %></span></div>
                        </div>
                        <div class="dato-servicio">
                          <i class="bi bi-clock"></i>
                          <div><strong>Hora:</strong> <span class="js-hora"><%= item.hora %></span></div>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="dato-servicio">
                          <i class="bi bi-geo-alt"></i>
                          <div><strong>Ubicación:</strong> <span class="js-ubicacion"><%= item.ubicacion %></span></div>
                        </div>
                        <div class="dato-servicio js-fila-referencias <%= item.referenciasUbicacion ? '' : 'd-none' %>">
                          <i class="bi bi-signpost-split"></i>
                          <div><strong>Referencias:</strong> <span class="js-referencias"><%= item.referenciasUbicacion %></span></div>
                        </div>
                      </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row gap-3 mt-3">
                      <% if (item.imagenEvidencia) { %>
                        <div>
                          <p class="fw-semibold mb-1 text-muted" style="font-size: 13px;">Evidencia adjunta</p>
                          <a href="<%= item.imagenEvidencia %>" target="_blank" title="Ver foto completa">
                            <img src="<%= item.imagenEvidencia %>" alt="Evidencia del problema" class="evidencia-img">
                          </a>
                        </div>
                      <% } %>
                      <div class="descripcion-servicio flex-grow-1 mt-0">
                        <div class="fw-semibold mb-1"><i class="bi bi-chat-left-text me-1"></i> Detalles del problema</div>
                        <p class="js-descripcion"><%= item.descripcion %></p>
                      </div>
                    </div>

                    <!-- PRECIO ESTIMADO DESGLOSADO -->
                    <div class="mt-3 p-3 rounded-3 border bg-light small">
                      <% if (item.estimado) { %>
                        <div class="fw-semibold mb-2"><i class="bi bi-cash-coin me-1"></i> Precio estimado</div>
                        <div class="d-flex justify-content-between"><span class="text-muted">Prestador (<%= item.unidadReferencia %>)</span><span><%= fmt(item.estimado.precioPrestador) %></span></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">Comisión PRAXO <%= item.estimado.comisionPorcentaje %>%</span><span><%= fmt(item.estimado.comision) %></span></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">IVA <%= item.estimado.ivaPorcentaje %>% sobre la comisión</span><span><%= fmt(item.estimado.ivaComision) %></span></div>
                        <div class="d-flex justify-content-between border-top mt-1 pt-1 fw-bold"><span>Total estimado</span><span><%= fmt(item.estimado.total) %></span></div>
                        <div class="text-muted mt-1" style="font-size: .75rem;">El precio final lo confirma el prestador en su cotización.</div>
                      <% } else { %>
                        <i class="bi bi-chat-left-dots me-1"></i> <strong>Precio a cotizar.</strong>
                        <span class="text-muted">Este prestador no publicó precio de referencia; te enviará su cotización.</span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ACCIONES -->
              <div class="col-md-3 text-md-end acciones-servicio mt-3 mt-md-0 d-flex flex-md-column gap-2 align-items-md-end">
                <button type="button" class="btn btn-outline-dark btn-sm js-editar" style="border-radius: 9px;">
                  <i class="bi bi-pencil-square me-1"></i> Editar
                </button>
                <form action="/carrito/eliminar/<%= item.id %>" method="POST" class="form-eliminar">
                  <button type="submit" class="btn-eliminar">
                    <i class="bi bi-trash3 me-1"></i> Eliminar
                  </button>
                </form>
              </div>

            </div>
          </article>
        <% }) %>
      </section>

      <!-- RESUMEN DESGLOSADO DEL CARRITO -->
      <section class="resumen-carrito">
        <div class="row g-4">
          <div class="col-lg-7">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-receipt me-2"></i>Resumen</h2>
            <table class="table table-sm table-borderless mb-1">
              <tbody>
                <tr><td class="text-muted ps-0">Servicios seleccionados</td><td class="text-end pe-0" id="resServicios"><%= resumen.servicios %></td></tr>
                <tr><td class="text-muted ps-0">Precio de los prestadores</td><td class="text-end pe-0" id="resPrestador"><%= fmt(resumen.precioPrestador) %></td></tr>
                <tr><td class="text-muted ps-0">Comisión PRAXO (<%= tarifas.COMISION_PORCENTAJE %>%)</td><td class="text-end pe-0" id="resComision"><%= fmt(resumen.comision) %></td></tr>
                <tr><td class="text-muted ps-0">IVA <%= tarifas.IVA_PORCENTAJE %>% sobre la comisión</td><td class="text-end pe-0" id="resIva"><%= fmt(resumen.ivaComision) %></td></tr>
                <tr class="border-top"><td class="fw-bold ps-0 pt-2 fs-5">Total estimado</td><td class="text-end fw-bold pe-0 pt-2 fs-5 text-success" id="resTotal"><%= fmt(resumen.total) %></td></tr>
              </tbody>
            </table>
            <p class="small text-muted mb-0" id="resACotizar">
              <% if (resumen.aCotizar > 0) { %>
                <i class="bi bi-info-circle me-1"></i> <%= resumen.aCotizar %> servicio(s) sin precio de referencia: su costo se sumará cuando el prestador cotice.
              <% } %>
            </p>
            <p class="small text-muted mt-2 mb-0"><i class="bi bi-shield-check me-1"></i> No se realiza ningún cobro al confirmar: solo pagas después de aceptar la cotización.</p>
          </div>

          <div class="col-lg-5">
            <div class="p-3 rounded-3 bg-light mb-3 small">
              <div class="fw-semibold mb-2"><i class="bi bi-journal-text me-1"></i> Políticas</div>
              <ul class="list-unstyled mb-0">
                <li class="mb-1"><a href="/politicas#precios" target="_blank">Precios y comisión</a></li>
                <li class="mb-1"><a href="/politicas#cancelaciones" target="_blank">Cancelaciones y reembolsos</a></li>
                <li class="mb-1"><a href="/politicas#garantia" target="_blank">Garantía PRAXO</a></li>
                <li class="mb-1"><a href="/terminos" target="_blank">Términos y condiciones</a></li>
                <li><a href="/aviso-privacidad" target="_blank">Aviso de privacidad</a></li>
              </ul>
            </div>
            <div class="d-flex flex-wrap gap-2 resumen-acciones">
              <form action="/carrito/vaciar" method="POST" id="formVaciar">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Vaciar</button>
              </form>
              <a href="/trabajadores" class="btn btn-outline-dark"><i class="bi bi-plus-lg me-1"></i> Agregar</a>
              <button type="button" class="btn btn-dark flex-grow-1" id="continuarContratacion">
                Continuar <i class="bi bi-arrow-right ms-1"></i>
              </button>
            </div>
          </div>
        </div>
      </section>

    <% } %>
  </main>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

  <% if (carrito && carrito.length > 0) { %>
    <!-- MODAL: EDITAR SERVICIO -->
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="formEditar" novalidate>
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i> Editar servicio</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="editId">
            <div class="row g-3">
              <div class="col-6">
                <label class="form-label small fw-semibold" for="editFecha">Fecha</label>
                <input type="date" class="form-control" id="editFecha" required>
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold" for="editHora">Hora</label>
                <input type="time" class="form-control" id="editHora" required>
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold" for="editUbicacion">Ubicación</label>
                <input type="text" class="form-control" id="editUbicacion" maxlength="150" required>
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold" for="editReferencias">Referencias (opcional)</label>
                <input type="text" class="form-control" id="editReferencias" maxlength="250">
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold" for="editDescripcion">Descripción del problema</label>
                <textarea class="form-control" id="editDescripcion" rows="3" maxlength="500" required></textarea>
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold" for="editUrgencia">Urgencia</label>
                <select class="form-select" id="editUrgencia">
                  <option value="Programado">Programado</option>
                  <option value="Urgencia">Emergencia</option>
                </select>
              </div>
              <div class="col-6 d-flex align-items-end">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" id="editCotizacion">
                  <label class="form-check-label small" for="editCotizacion">Requiere cotización previa</label>
                </div>
              </div>
            </div>
            <div class="alert alert-danger mt-3 mb-0 d-none" id="errorEditar"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-dark" id="btnGuardarEdicion"><i class="bi bi-check-lg me-1"></i> Guardar cambios</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL: CONFIRMAR CONTRATACIÓN -->
    <div class="modal fade" id="modalContinuar" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form action="/carrito/confirmar" method="POST" class="modal-content" id="formConfirmar">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i> Confirmar contratación</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <p class="mb-1">Enviarás <strong id="modalServicios"><%= resumen.servicios %></strong> solicitud(es) a los prestadores.</p>
            <p class="mb-3">Total estimado: <strong id="modalTotal"><%= tarifas.formatoMXN(resumen.total) %> MXN</strong></p>
            <p class="small text-muted">Cada prestador te enviará su cotización. No se cobra nada hasta que aceptes y pagues.</p>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="aceptaPoliticas" id="aceptaPoliticas" required>
              <label class="form-check-label small" for="aceptaPoliticas">
                He leído y acepto las <a href="/politicas" target="_blank">Políticas de compra</a>
                (precios, comisión, cancelaciones y reembolsos). <span class="text-danger">*</span>
              </label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Regresar</button>
            <button type="submit" class="btn btn-dark" id="btnConfirmar" disabled>
              <i class="bi bi-send-check me-1"></i> Confirmar contratación
            </button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <!-- BOOTSTRAP JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- JS GENERAL DE PRAXO -->
  <script src="/js/main.js"></script>

  <!-- JS DEL CARRITO: edición y eliminación sin recargar + resumen en vivo -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const fmt = (n) => Number(n).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
      const r2 = (n) => Math.round((n + Number.EPSILON) * 100) / 100;
      const aviso = document.getElementById('avisoCarrito');

      function mostrarAviso(texto, tipo) {
        if (!aviso) return;
        aviso.innerHTML = '<div class="alert alert-' + tipo + ' alert-dismissible fade show">' + texto +
          '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
      }

      // ---------- Resumen en vivo ----------
      function recalcular() {
        const items = document.querySelectorAll('#listaServicios .servicio-card');
        let p = 0, c = 0, i = 0, t = 0, aCotizar = 0;
        items.forEach((el) => {
          if (el.dataset.total) {
            p += Number(el.dataset.prestador); c += Number(el.dataset.comision);
            i += Number(el.dataset.iva); t += Number(el.dataset.total);
          } else { aCotizar++; }
        });
        const set = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
        set('resServicios', items.length);
        set('resPrestador', fmt(r2(p)));
        set('resComision', fmt(r2(c)));
        set('resIva', fmt(r2(i)));
        set('resTotal', fmt(r2(t)));
        set('modalServicios', items.length);
        set('modalTotal', fmt(r2(t)) + ' MXN');
        const nota = document.getElementById('resACotizar');
        if (nota) nota.innerHTML = aCotizar > 0
          ? '<i class="bi bi-info-circle me-1"></i> ' + aCotizar + ' servicio(s) sin precio de referencia: su costo se sumará cuando el prestador cotice.'
          : '';
        document.querySelectorAll('.js-contador-carrito').forEach((b) => {
          b.textContent = items.length;
          b.classList.toggle('d-none', items.length === 0);
        });
        if (items.length === 0) window.location.reload(); // muestra el estado "carrito vacío"
      }

      // ---------- Eliminar sin recargar ----------
      document.querySelectorAll('.form-eliminar').forEach((formulario) => {
        formulario.addEventListener('submit', async (evento) => {
          evento.preventDefault();
          if (!confirm('¿Deseas eliminar este servicio de tu selección?')) return;
          try {
            const r = await fetch(formulario.action, { method: 'POST', headers: { 'Accept': 'application/json' } });
            if (!r.ok) throw new Error();
            const tarjeta = formulario.closest('.servicio-card');
            tarjeta.style.transition = 'opacity .25s'; tarjeta.style.opacity = '0';
            setTimeout(() => { tarjeta.remove(); recalcular(); }, 250);
            mostrarAviso('Servicio eliminado.', 'secondary');
          } catch (e) {
            mostrarAviso('No se pudo eliminar el servicio. Intenta de nuevo.', 'danger');
          }
        });
      });

      const formVaciar = document.getElementById('formVaciar');
      if (formVaciar) {
        formVaciar.addEventListener('submit', (evento) => {
          if (!confirm('¿Deseas eliminar todos los servicios seleccionados?')) evento.preventDefault();
        });
      }

      // ---------- Editar sin recargar ----------
      const modalEditarEl = document.getElementById('modalEditar');
      const modalEditar = modalEditarEl ? new bootstrap.Modal(modalEditarEl) : null;
      const $ = (id) => document.getElementById(id);
      const hoy = new Date(); hoy.setMinutes(hoy.getMinutes() - hoy.getTimezoneOffset());
      if ($('editFecha')) $('editFecha').min = hoy.toISOString().slice(0, 10);

      document.querySelectorAll('.js-editar').forEach((boton) => {
        boton.addEventListener('click', () => {
          const d = boton.closest('.servicio-card').dataset;
          $('editId').value = d.id;
          $('editFecha').value = d.fecha;
          $('editHora').value = d.hora;
          $('editUbicacion').value = d.ubicacion;
          $('editReferencias').value = d.referencias;
          $('editDescripcion').value = d.descripcion;
          $('editUrgencia').value = d.urgencia === 'Urgencia' ? 'Urgencia' : 'Programado';
          $('editCotizacion').checked = d.cotizacion === '1';
          $('errorEditar').classList.add('d-none');
          modalEditar.show();
        });
      });

      const formEditar = $('formEditar');
      if (formEditar) {
        formEditar.addEventListener('submit', async (evento) => {
          evento.preventDefault();
          const id = $('editId').value;
          const datos = {
            fecha: $('editFecha').value, hora: $('editHora').value,
            ubicacion: $('editUbicacion').value.trim(), referenciasUbicacion: $('editReferencias').value.trim(),
            descripcion: $('editDescripcion').value.trim(), urgencia: $('editUrgencia').value,
            requiereCotizacion: $('editCotizacion').checked
          };
          const btn = $('btnGuardarEdicion');
          btn.disabled = true;
          try {
            const r = await fetch('/carrito/editar/' + id, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(datos)
            });
            const res = await r.json();
            if (!r.ok) throw new Error(res.mensaje || 'No se pudo guardar.');

            // Actualizar la tarjeta con lo que confirmó el servidor
            const s = res.servicio;
            const card = document.getElementById('item-' + id);
            Object.assign(card.dataset, {
              fecha: s.fecha, hora: s.hora, ubicacion: s.ubicacion, referencias: s.referenciasUbicacion || '',
              descripcion: s.descripcion, urgencia: s.urgencia, cotizacion: s.requiereCotizacion ? '1' : '0'
            });
            card.querySelector('.js-fecha').textContent = new Date(s.fecha + 'T00:00:00')
              .toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' });
            card.querySelector('.js-hora').textContent = s.hora;
            card.querySelector('.js-ubicacion').textContent = s.ubicacion;
            card.querySelector('.js-referencias').textContent = s.referenciasUbicacion || '';
            card.querySelector('.js-fila-referencias').classList.toggle('d-none', !s.referenciasUbicacion);
            card.querySelector('.js-descripcion').textContent = s.descripcion;
            card.querySelector('.js-badge-urgencia').classList.toggle('d-none', s.urgencia !== 'Urgencia');
            card.querySelector('.js-badge-cotizacion').classList.toggle('d-none', !s.requiereCotizacion);

            modalEditar.hide();
            card.classList.add('border', 'border-success');
            setTimeout(() => card.classList.remove('border', 'border-success'), 1500);
            mostrarAviso('Servicio actualizado.', 'success');
          } catch (e) {
            $('errorEditar').textContent = e.message;
            $('errorEditar').classList.remove('d-none');
          } finally {
            btn.disabled = false;
          }
        });
      }

      // ---------- Confirmar: requiere aceptar políticas ----------
      const botonContinuar = $('continuarContratacion');
      if (botonContinuar) {
        botonContinuar.addEventListener('click', () => new bootstrap.Modal($('modalContinuar')).show());
      }
      const checkPoliticas = $('aceptaPoliticas');
      if (checkPoliticas) {
        checkPoliticas.addEventListener('change', () => { $('btnConfirmar').disabled = !checkPoliticas.checked; });
      }
    });
  </script>
</body>
</html>