<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Encuentra tu Servicio</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <div class="card shadow-sm">
          <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h1 class="h3 mb-1"><%= trabajador.nombre %></h1>
                <h2 class="h6 text-muted"><%= trabajador.oficio %></h2>
              </div>

              <% if (trabajador.disponibleAhora) { %>
                <span class="badge bg-success">Disponible ahora</span>
              <% } else { %>
                <span class="badge bg-secondary">No disponible</span>
              <% } %>
            </div>

            <hr>

            <p><%= trabajador.descripcion %></p>

            <ul class="list-unstyled">
              <li><strong>Ciudad:</strong> <%= trabajador.ciudad %></li>
              <li><strong>Teléfono:</strong> <%= trabajador.telefono %></li>
              <li><strong>Calificación:</strong> <%= trabajador.calificacionPromedio %> / 5</li>
            </ul>

            <a href="/trabajadores" class="btn btn-outline-secondary">Volver a la lista</a>

          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
