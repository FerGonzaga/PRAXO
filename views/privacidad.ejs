<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-light">

  <%- include('partials/navbar') %>

  <%
    const fecha = (f) => f ? new Date(f).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', dateStyle: 'long', timeStyle: 'short' }) : '—';
    const priv = consentimiento.privacidad || {};
    const prom = consentimiento.promociones || {};
    const term = consentimiento.terminos || {};
    const versionVieja = priv.aceptado && priv.version !== privacidad.VERSION_AVISO;
  %>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-9">

        <h1 class="h3 fw-bold mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Centro de privacidad</h1>
        <p class="text-muted mb-4">Administra tu consentimiento y ejerce tus derechos sobre tus datos personales.</p>

        <% if (aviso === 'aceptado') { %>
          <div class="alert alert-success">Registramos tu aceptación del Aviso de Privacidad.</div>
        <% } else if (aviso === 'promo-on') { %>
          <div class="alert alert-success">Listo: recibirás promociones y novedades de PRAXO.</div>
        <% } else if (aviso === 'promo-off') { %>
          <div class="alert alert-secondary">Listo: ya no usaremos tus datos para promociones.</div>
        <% } %>

        <!-- CONSENTIMIENTO -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h2 class="h5 fw-bold mb-3">Tu consentimiento</h2>

          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 py-3 border-bottom">
            <div>
              <div class="fw-semibold">Aviso de Privacidad (finalidades primarias)</div>
              <small class="text-muted">
                <% if (priv.aceptado) { %>
                  Aceptado el <%= fecha(priv.fecha) %> · versión <%= priv.version || 'sin registrar' %>
                <% } else { %>
                  Tu cuenta se creó antes de que existiera este registro.
                <% } %>
              </small>
            </div>
            <% if (priv.aceptado && !versionVieja) { %>
              <span class="badge bg-success align-self-center"><i class="bi bi-check-circle me-1"></i>Aceptado</span>
            <% } else { %>
              <form action="/perfil/privacidad/aceptar" method="POST">
                <button class="btn btn-primary btn-sm">
                  <%= versionVieja ? 'Aceptar la versión actual' : 'Leí y acepto el aviso' %>
                </button>
              </form>
            <% } %>
          </div>

          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 py-3 border-bottom">
            <div>
              <div class="fw-semibold">Términos y Condiciones</div>
              <small class="text-muted"><%= term.aceptado ? 'Aceptados el ' + fecha(term.fecha) : 'Sin registro de fecha' %></small>
            </div>
            <a href="/terminos" class="btn btn-outline-secondary btn-sm align-self-center">Consultar</a>
          </div>

          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pt-3">
            <div>
              <div class="fw-semibold">Promociones, novedades y encuestas <span class="badge bg-light text-muted border">opcional</span></div>
              <small class="text-muted">
                <%= prom.aceptado ? 'Activado' : 'Desactivado' %><%= prom.fecha ? ' desde el ' + fecha(prom.fecha) : '' %>.
                Puedes cambiarlo cuando quieras.
              </small>
            </div>
            <form action="/perfil/privacidad/promociones" method="POST" class="align-self-center">
              <input type="hidden" name="promociones" value="<%= prom.aceptado ? 'no' : 'si' %>">
              <button class="btn btn-sm <%= prom.aceptado ? 'btn-outline-danger' : 'btn-outline-success' %>">
                <%= prom.aceptado ? 'Revocar consentimiento' : 'Activar' %>
              </button>
            </form>
          </div>
        </div>

        <!-- DERECHOS ARCO -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h2 class="h5 fw-bold mb-3">Tus derechos ARCO</h2>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <div class="fw-semibold"><i class="bi bi-download me-1 text-primary"></i> Acceso</div>
                <p class="small text-muted mb-2">Descarga una copia de todos los datos que PRAXO tiene sobre ti.</p>
                <a href="/perfil/privacidad/mis-datos" class="btn btn-dark btn-sm">Descargar mis datos (JSON)</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <div class="fw-semibold"><i class="bi bi-pencil-square me-1 text-primary"></i> Rectificación</div>
                <p class="small text-muted mb-2">Revisa tus datos en tu perfil. Si alguno es incorrecto, solicítanos corregirlo.</p>
                <a href="/perfil" class="btn btn-outline-dark btn-sm">Ir a mi perfil</a>
              </div>
            </div>
            <div class="col-12">
              <div class="border rounded-3 p-3">
                <div class="fw-semibold"><i class="bi bi-envelope me-1 text-primary"></i> Cancelación y Oposición</div>
                <p class="small text-muted mb-0">
                  Escribe a <strong><%= privacidad.CORREO_PRIVACIDAD %></strong> desde el correo de tu cuenta
                  (<%= usuario.correo %>) indicando el derecho que deseas ejercer y los datos involucrados.
                </p>
              </div>
            </div>
          </div>
        </div>

        <p class="small text-muted">
          Consulta el <a href="/aviso-privacidad">Aviso de Privacidad Integral</a> (versión <%= privacidad.VERSION_AVISO %>).
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
