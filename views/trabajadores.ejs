<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Encuentra tu Servicio</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="mb-4"><%= titulo %></h1>

    <% if (trabajadores.length === 0) { %>
      <p class="text-muted">Todavia no hay trabajadores registrados.</p>
    <% } else { %>
      <div class="row g-4">
        <% trabajadores.forEach((trabajador) => { %>
          <div class="col-md-4">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= trabajador.nombre %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= trabajador.oficio %></h6>
                <p class="card-text"><%= trabajador.descripcion %></p>
                <p class="card-text">
                  <small class="text-muted"><%= trabajador.ciudad %></small>
                </p>
                <a href="/trabajadores/<%= trabajador._id %>" class="btn btn-sm btn-outline-primary">
                  Ver perfil
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
