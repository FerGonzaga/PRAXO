<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PRAXO - Oficios al instante</title>
  <!-- Fuente Montserrat de Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <link href="https://unpkg.com/maplibre-gl@3.3.1/dist/maplibre-gl.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl@3.3.1/dist/maplibre-gl.js"></script>

  <!-- Ícono de la pestaña (con diagonales normales "/", las "\" no funcionan en todos los navegadores) -->
  <link rel="icon" type="image/png" href="/assets/img/logo/logo.png">

</head>

<body>

  <%- include('partials/navbar') %>

    <!-- =====================================
         HERO: banner con slider de fondo
         El degradado azul marino (.hero-overlay) garantiza que el texto
         se lea sobre cualquiera de las fotos.
    ====================================== -->
    <section class="hero-seccion position-relative text-white overflow-hidden" style="height: 80vh; min-height: 580px;">

      <!-- SLIDER DE FONDO -->
      <div id="sliderPrincipal" class="carousel slide carousel-fade position-absolute top-0 start-0 w-100 h-100"
        data-bs-ride="carousel" style="z-index: 1;">

        <!-- INDICADORES -->
        <div class="carousel-indicators mb-4" style="z-index: 3;">
          <button type="button" data-bs-target="#sliderPrincipal" data-bs-slide-to="0" class="active"
            aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#sliderPrincipal" data-bs-slide-to="1" aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#sliderPrincipal" data-bs-slide-to="2" aria-label="Slide 3"></button>
          <button type="button" data-bs-target="#sliderPrincipal" data-bs-slide-to="3" aria-label="Slide 4"></button>
          <button type="button" data-bs-target="#sliderPrincipal" data-bs-slide-to="4" aria-label="Slide 5"></button>
        </div>

        <!-- CONTENIDO DEL SLIDER (IMÁGENES DE FONDO) -->
        <div class="carousel-inner w-100 h-100">

          <!-- SLIDE 1 -->
          <div class="carousel-item active w-100 h-100">
            <img src="/assets/img/imgs/albanil.jpeg" class="d-block w-100 h-100"
              style="object-fit: cover; object-position: center;" alt="Albañil">
          </div>

          <!-- SLIDE 2 -->
          <div class="carousel-item w-100 h-100">
            <img src="/assets/img/imgs/elec.jpg" class="d-block w-100 h-100"
              style="object-fit: cover; object-position: center;" alt="Electricista">
          </div>

          <!-- SLIDE 3 -->
          <div class="carousel-item w-100 h-100">
            <img src="/assets/img/imgs/fletes.jpg" class="d-block w-100 h-100"
              style="object-fit: cover; object-position: center;" alt="Fletes">
          </div>

          <!-- SLIDE 4 -->
          <div class="carousel-item w-100 h-100">
            <img src="/assets/img/imgs/plomero.jpg" class="d-block w-100 h-100"
              style="object-fit: cover; object-position: center;" alt="Plomero">
          </div>

          <!-- SLIDE 5 -->
          <div class="carousel-item w-100 h-100">
            <img src="/assets/img/imgs/carpi.jpg" class="d-block w-100 h-100"
              style="object-fit: cover; object-position: center;" alt="Carpintero">
          </div>

        </div>

        <!-- CONTROLES -->
        <button class="carousel-control-prev" type="button" data-bs-target="#sliderPrincipal" data-bs-slide="prev"
          style="z-index: 4;">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#sliderPrincipal" data-bs-slide="next"
          style="z-index: 4;">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Siguiente</span>
        </button>

      </div>

      <!-- CAPA DE DEGRADADO AZUL MARINO (sustituye al negro plano al 30%) -->
      <div class="hero-overlay"></div>

      <!-- CONTENIDO AL FRENTE: texto alineado a la izquierda, sobre la zona más oscura -->
      <div class="container position-relative d-flex align-items-center h-100 py-5" style="z-index: 3;">
        <div class="hero-contenido">

          <span class="hero-insignia mb-3">
            <i class="bi bi-lightning-charge-fill"></i> Oficios al instante
          </span>

          <h1 class="hero-titulo display-4 fw-bold mb-3 text-white">
            Un profesional para cada necesidad,
            <span class="hero-acento">cuando lo necesites</span>
          </h1>

          <p class="hero-subtitulo lead mb-4">
            Electricistas, plomeros, cerrajeros y más, disponibles ahora mismo o programados para el día que tú
            elijas.
          </p>

          <!-- Buscador -->
          <form action="/trabajadores" method="GET"
            class="bg-white rounded-4 p-2 d-flex flex-column flex-md-row gap-2 shadow-lg"
            style="max-width: 640px;">
            <select name="oficio" class="form-select border-0 text-dark py-2" aria-label="Servicio que buscas">
              <option selected value="">¿Qué servicio buscas?</option>
              <option value="Electricista">Electricista</option>
              <option value="Plomero">Plomero</option>
              <option value="Cerrajero">Cerrajero</option>
              <option value="Albañil">Albañil</option>
              <option value="Pintor">Pintor</option>
            </select>
            <input type="text" name="ciudad" class="form-control border-0 text-dark py-2" placeholder="Tu ciudad"
              aria-label="Tu ciudad">
            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
              <i class="bi bi-search"></i> Buscar
            </button>
          </form>

          <!-- Puntos de confianza -->
          <div class="hero-confianza mt-4">
            <span><i class="bi bi-patch-check"></i>Cuentas con correo verificado</span>
            <span><i class="bi bi-calendar-check"></i>Ahora o programado</span>
            <span><i class="bi bi-cash-coin"></i>Pide cotización antes</span>
          </div>

        </div>
      </div>

    </section>

    <!-- CATEGORIAS estilo Uber Eats: iconos en fila horizontal -->
    <section class="container py-4">
      <h2 class="h5 mb-3 text-center">Explora por categoría</h2>

      <div class="d-flex justify-content-center gap-3 overflow-auto pb-2 categorias-scroll">
        <a href="/trabajadores?oficio=Electricista" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-lightning-charge-fill"></i>
          </div>
          <span class="small text-dark">Electricista</span>
        </a>

        <a href="/trabajadores?oficio=Plomero" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-droplet-fill"></i>
          </div>
          <span class="small text-dark">Plomero</span>
        </a>

        <a href="/trabajadores?oficio=Cerrajero" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-key-fill"></i>
          </div>
          <span class="small text-dark">Cerrajero</span>
        </a>

        <a href="/trabajadores?oficio=Albañil" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-bricks"></i>
          </div>
          <span class="small text-dark">Albañil</span>
        </a>

        <a href="/trabajadores?oficio=Pintor" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-brush-fill"></i>
          </div>
          <span class="small text-dark">Pintor</span>
        </a>

        <a href="/trabajadores" class="categoria-card text-center text-decoration-none">
          <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
            <i class="bi bi-grid-fill"></i>
          </div>
          <span class="small text-dark">Ver todos</span>
        </a>
      </div>
    </section>

    <!-- DESTACADOS: trabajadores mejor calificados -->
    <section class="container py-4">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <h2 class="h5 mb-0">Profesionales mejor calificados</h2>
        <a href="/trabajadores" class="small fw-semibold">Ver todos</a>
      </div>

      <% if (destacados.length===0) { %>
        <p class="text-muted">Aún no hay trabajadores registrados.</p>
        <% } else { %>
          <div class="row g-3">
            <% destacados.forEach((trabajador)=> { %>
              <div class="col-6 col-md-3">
                <a href="/trabajadores/<%= trabajador._id %>" class="text-decoration-none text-dark">
                  <div class="card h-100 border-0 shadow-sm">

                    <!-- Si no existe fotoUrl se busca una imagen local con el primer nombre del trabajador;
                         si tampoco existe, se genera un avatar con ui-avatars.com -->
                    <img
                      src="<%= (trabajador.fotoUrl ? trabajador.fotoUrl.replace(/\\/g, '/') : '/assets/img/trabajadores/' + trabajador.nombre.toLowerCase().split(' ')[0] + '.jpg') %>"
                      onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(trabajador.nombre) %>&background=random&size=200';"
                      class="card-img-top" alt="<%= trabajador.nombre %>" style="height: 140px; object-fit: cover;">

                    <div class="card-body p-2">
                      <h3 class="h6 mb-0">
                        <%= trabajador.nombre %>
                      </h3>
                      <p class="small text-muted mb-1">
                        <%= trabajador.oficio %>
                      </p>
                      <span class="badge bg-warning text-dark">
                        <i class="bi bi-star-fill"></i>
                        <%= trabajador.calificacionPromedio %>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
              <% }) %>
          </div>
          <% } %>
    </section>

    <!-- =====================================
         POR QUÉ PRAXO: lo que ya se puede hacer en la plataforma
    ====================================== -->
    <section class="bg-light py-5">
      <div class="container">

        <div class="seccion-titulo">
          <span class="seccion-etiqueta">¿Por qué PRAXO?</span>
          <h2 class="h3 fw-bold mt-1">Todo lo que necesitas para contratar con confianza</h2>
          <p>Desde encontrar al profesional adecuado hasta explicar el problema, en un solo lugar.</p>
        </div>

        <div class="row g-4">

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-person-badge"></i></div>
              <h3>Perfiles claros</h3>
              <p>Consulta el oficio, la ciudad, la descripción y la calificación de cada profesional antes de decidir.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-calendar-check"></i></div>
              <h3>Ahora o cuando quieras</h3>
              <p>Elige fecha y hora, o indica que es una urgencia para que el profesional lo sepa desde el principio.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-cash-coin"></i></div>
              <h3>Cotización antes del servicio</h3>
              <p>Pide que el profesional evalúe tu solicitud y te indique el costo aproximado.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-camera"></i></div>
              <h3>Muestra el problema</h3>
              <p>Adjunta una foto y referencias de tu ubicación para que el profesional vea el trabajo.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-bag-check"></i></div>
              <h3>Todo en un solo lugar</h3>
              <p>Reúne varios servicios en «Mis servicios» y revisa los datos antes de continuar.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="beneficio-card">
              <div class="beneficio-icono"><i class="bi bi-patch-check"></i></div>
              <h3>Cuentas verificadas</h3>
              <p>Cada cuenta se activa al confirmar el correo electrónico con el que se registra.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="py-5">
      <div class="container">

        <div class="seccion-titulo">
          <span class="seccion-etiqueta">Paso a paso</span>
          <h2 class="h3 fw-bold mt-1">¿Cómo funciona?</h2>
        </div>

        <div class="row text-center g-4">
          <div class="col-md-4">
            <div class="paso-numero">1</div>
            <h3 class="h6">Busca</h3>
            <p class="small text-muted">Elige el oficio que necesitas y tu ubicación.</p>
          </div>
          <div class="col-md-4">
            <div class="paso-numero">2</div>
            <h3 class="h6">Contacta</h3>
            <p class="small text-muted">Revisa perfiles, calificaciones y comunícate.</p>
          </div>
          <div class="col-md-4">
            <div class="paso-numero">3</div>
            <h3 class="h6">Recibe el servicio</h3>
            <p class="small text-muted">Ahora mismo o programado para el día que elijas.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA para anunciarse como profesional -->
    <section class="container pb-5">
      <div class="row align-items-center bg-dark text-white rounded-4 p-4 p-md-5">
        <div class="col-md-8">
          <h2 class="h4">¿Ofreces un servicio? Anúnciate gratis</h2>
          <p class="text-white-50 mb-3">
            Llega a más clientes cerca de ti y recibe solicitudes ahora mismo.
          </p>
          <ul class="list-unstyled small mb-md-0">
            <li class="mb-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Crea tu perfil con tu oficio, ciudad y descripción</li>
            <li class="mb-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Recibe solicitudes de clientes</li>
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Anunciarte no tiene costo</li>
          </ul>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
          <a href="/registro/prestador" class="btn btn-primary btn-lg">Regístrate como profesional</a>
        </div>
      </div>
    </section>

    <!-- =====================================
         PREGUNTAS FRECUENTES
    ====================================== -->
    <section class="bg-light py-5">
      <div class="container" style="max-width: 820px;">

        <div class="seccion-titulo">
          <span class="seccion-etiqueta">Ayuda</span>
          <h2 class="h3 fw-bold mt-1">Preguntas frecuentes</h2>
        </div>

        <div class="accordion faq" id="faqPraxo">

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1"
                aria-expanded="true" aria-controls="faq1">
                ¿Cómo solicito un servicio?
              </button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqPraxo">
              <div class="accordion-body">
                Crea tu cuenta de cliente, busca al profesional que necesitas y presiona «Contratar». Indica la fecha,
                la hora y tu dirección, y describe lo que necesitas. El servicio se agrega a «Mis servicios» para que
                lo revises antes de continuar.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                ¿Puedo pedir una cotización antes de contratar?
              </button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqPraxo">
              <div class="accordion-body">
                Sí. Al llenar la solicitud marca la opción «Solicitar cotización antes del servicio». El profesional
                evaluará tu solicitud y te indicará el costo aproximado.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                ¿Qué hago si es una urgencia?
              </button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqPraxo">
              <div class="accordion-body">
                En la solicitud elige el nivel de urgencia «Urgencia/Emergencia» para que el profesional sepa que es
                prioritario. También puedes adjuntar una foto del problema para que vea el trabajo.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#faq4" aria-expanded="false" aria-controls="faq4">
                ¿Cómo me anuncio como prestador de servicios?
              </button>
            </h3>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqPraxo">
              <div class="accordion-body">
                Crea una cuenta de prestador y completa tu oficio, teléfono, ciudad y una descripción de tus
                servicios. Anunciarte no tiene costo.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#faq5" aria-expanded="false" aria-controls="faq5">
                ¿Por qué debo verificar mi correo?
              </button>
            </h3>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqPraxo">
              <div class="accordion-body">
                Al registrarte te enviamos un enlace de verificación. Confirmarlo activa tu cuenta y permite iniciar
                sesión. Revisa también tu carpeta de spam si no lo ves.
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Mapa -->
    <section class="container pt-5 pb-3">
      <div class="seccion-titulo mb-0">
        <span class="seccion-etiqueta">Ubicación</span>
        <h2 class="h3 fw-bold mt-1">Explora el mapa</h2>
        <p>Ubica la zona donde necesitas el servicio.</p>
      </div>
    </section>

    <div id="map" style="width: 100%; height: 350px;"></div>

    <%- include('partials/footer') %>

      <!-- =====================================
         BOTÓN FLOTANTE DE WHATSAPP
    ====================================== -->

      <div class="whatsapp-widget">

        <!-- Mensaje que aparece al pasar el mouse -->
        <div class="whatsapp-tooltip">
          ¿Necesitas ayuda? Escríbenos
        </div>

        <!-- Botón -->
        <a href="#" id="whatsappButton" class="whatsapp-float" target="_blank" rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp">
          <i class="bi bi-whatsapp"></i>
        </a>

      </div>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>
      <script src="/js/modules/mapa.js"></script>
</body>

</html>
