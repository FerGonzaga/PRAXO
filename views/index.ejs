<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Encuentra tu Servicio</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- HERO estilo Uber: fondo oscuro, texto grande, buscador prominente -->
  <section class="hero-seccion text-white">
    <div class="container py-5">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <h1 class="display-5 fw-bold mb-3">
            Un profesional para cada necesidad, cuando lo necesites
          </h1>
          <p class="lead mb-4">
            Electricistas, plomeros, cerrajeros y más, disponibles ahora
            mismo o programados para el día que tú elijas.
          </p>

          <!-- Buscador tipo Uber Eats: categoria + ubicacion + boton -->
          <form action="/trabajadores" method="GET" class="bg-white rounded-3 p-2 d-flex flex-column flex-md-row gap-2 shadow">
            <select name="oficio" class="form-select border-0">
              <option selected value="">¿Qué servicio buscas?</option>
              <option value="Electricista">Electricista</option>
              <option value="Plomero">Plomero</option>
              <option value="Cerrajero">Cerrajero</option>
              <option value="Albañil">Albañil</option>
              <option value="Pintor">Pintor</option>
            </select>
            <input
              type="text"
              name="ciudad"
              class="form-control border-0"
              placeholder="Tu ciudad"
            >
            <button type="submit" class="btn btn-dark px-4">
              <i class="bi bi-search"></i> Buscar
            </button>
          </form>
        </div>

        <div class="col-lg-5 d-none d-lg-block text-center">
          <img
            src="/assets/img/backgrounds/hero-trabajador.png"
            alt="Profesional de servicios"
            class="img-fluid"
          >
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORIAS estilo Uber Eats: iconos en fila horizontal -->
  <section class="container py-4">
    <h2 class="h5 mb-3">Explora por categoría</h2>
    <div class="d-flex gap-3 overflow-auto pb-2 categorias-scroll">

      <a href="/trabajadores?oficio=Electricista" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-lightning-charge-fill"></i>
        </div>
        <span class="small text-dark">Electricista</span>
      </a>

      <a href="/trabajadores?oficio=Plomero" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-droplet-fill"></i>
        </div>
        <span class="small text-dark">Plomero</span>
      </a>

      <a href="/trabajadores?oficio=Cerrajero" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-key-fill"></i>
        </div>
        <span class="small text-dark">Cerrajero</span>
      </a>

      <a href="/trabajadores?oficio=Albañil" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-bricks"></i>
        </div>
        <span class="small text-dark">Albañil</span>
      </a>

      <a href="/trabajadores?oficio=Pintor" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-brush-fill"></i>
        </div>
        <span class="small text-dark">Pintor</span>
      </a>

      <a href="/trabajadores" class="categoria-card text-center text-decoration-none">
        <div class="categoria-icono bg-light rounded-circle mx-auto mb-2">
          <i class="bi bi-grid-fill"></i>
        </div>
        <span class="small text-dark">Ver todos</span>
      </a>

    </div>
  </section>

  <!-- DESTACADOS: trabajadores mejor calificados, jalados de Mongo -->
  <section class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h5 mb-0">Profesionales mejor calificados</h2>
      <a href="/trabajadores" class="small">Ver todos</a>
    </div>

    <% if (destacados.length === 0) { %>
      <p class="text-muted">Aún no hay trabajadores registrados.</p>
    <% } else { %>
      <div class="row g-3">
        <% destacados.forEach((trabajador) => { %>
          <div class="col-6 col-md-3">
            <a href="/trabajadores/<%= trabajador._id %>" class="text-decoration-none text-dark">
              <div class="card h-100 border-0 shadow-sm">
                <img
                  src="<%= trabajador.fotoUrl || '/assets/images/services/default-trabajador.png' %>"
                  class="card-img-top"
                  alt="<%= trabajador.nombre %>"
                  style="height: 140px; object-fit: cover;"
                >
                <div class="card-body p-2">
                  <h3 class="h6 mb-0"><%= trabajador.nombre %></h3>
                  <p class="small text-muted mb-1"><%= trabajador.oficio %></p>
                  <span class="badge bg-warning text-dark">
                    <i class="bi bi-star-fill"></i> <%= trabajador.calificacionPromedio %>
                  </span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- COMO FUNCIONA: 3 pasos, estilo apps de servicios -->
  <section class="bg-light py-5">
    <div class="container">
      <h2 class="h5 text-center mb-4">¿Cómo funciona?</h2>
      <div class="row text-center g-4">
        <div class="col-md-4">
          <i class="bi bi-search fs-1 text-primary"></i>
          <h3 class="h6 mt-2">1. Busca</h3>
          <p class="small text-muted">Elige el oficio que necesitas y tu ubicación.</p>
        </div>
        <div class="col-md-4">
          <i class="bi bi-chat-dots fs-1 text-primary"></i>
          <h3 class="h6 mt-2">2. Contacta</h3>
          <p class="small text-muted">Revisa perfiles, calificaciones y comunícate.</p>
        </div>
        <div class="col-md-4">
          <i class="bi bi-check-circle fs-1 text-primary"></i>
          <h3 class="h6 mt-2">3. Recibe el servicio</h3>
          <p class="small text-muted">Ahora mismo o programado para el día que elijas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA para anunciarse como profesional -->
  <section class="container py-5">
    <div class="row align-items-center bg-dark text-white rounded-4 p-4 p-md-5">
      <div class="col-md-8">
        <h2 class="h4">¿Ofreces un servicio? Anúnciate gratis</h2>
        <p class="mb-md-0 text-white-50">
          Llega a más clientes cerca de ti y recibe solicitudes ahora mismo.
        </p>
      </div>
      <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="/registro" class="btn btn-light">Regístrate como profesional</a>
      </div>
    </div>
  </section>

  <!-- Seccion Quienes somos -->
  <div class="container py-4 mb-5">
    <h2 class="h5">Quiénes somos</h2>
    <p class="text-muted">
      Conectamos a personas que necesitan un servicio (electricista, plomero,
      cerrajero, albañil, entre otros) con profesionales confiables cerca de
      ellas, ya sea para atención inmediata o programada.
    </p>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
