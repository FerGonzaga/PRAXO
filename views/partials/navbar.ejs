<!-- views/partials/navbar.ejs -->

<!-- Tema de color PRAXO (azul marino + naranja).
     Se carga desde aquí para que se aplique en TODAS las páginas que incluyen
     la barra, sin editar el <head> de cada vista. Al estar dentro del <body>
     se carga DESPUÉS de Bootstrap, custom.css y los <style> internos de cada
     página, así que siempre gana.
     El ?v=3 evita que el navegador use una copia vieja guardada en caché:
     súbelo a ?v=4, ?v=5... cada vez que cambies praxo-theme.css. -->
<link rel="stylesheet" href="/css/praxo-theme.css?v=3">

<%
  // Comprobamos de forma segura si existe una sesión activa.
  const sesionActiva =
    typeof usuarioAutenticado !== 'undefined' &&
    usuarioAutenticado &&
    typeof usuarioActual !== 'undefined' &&
    usuarioActual;

  const navEsCliente =
    sesionActiva && usuarioActual.tipoUsuario === 'cliente';

  const navTotalCarrito =
    (typeof cantidadCarrito !== 'undefined' && cantidadCarrito > 0)
      ? cantidadCarrito
      : 0;

  const navInicial =
    sesionActiva && usuarioActual.nombre
      ? String(usuarioActual.nombre).trim().charAt(0).toUpperCase()
      : '';
%>


<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">

  <div class="container">


    <!-- ==========================================
         LOGO PRAXO (logo de ejemplo; cuando exista el oficial
         basta con reemplazar el archivo, conservando el nombre)
    =========================================== -->

    <a
      class="navbar-brand d-flex align-items-center"
      href="/"
      aria-label="PRAXO, ir al inicio"
    >

      <img
        src="/assets/img/logo/logo-praxo-claro.svg"
        alt="PRAXO"
        width="148"
        height="38"
      >

    </a>



    <!-- ==========================================
         BOTON RESPONSIVE
    =========================================== -->

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Abrir navegación"
    >

      <span class="navbar-toggler-icon"></span>

    </button>



    <!-- ==========================================
         OPCIONES DEL NAVBAR
    =========================================== -->

    <div
      class="collapse navbar-collapse"
      id="navbarNav"
    >

      <ul
        class="navbar-nav ms-auto align-items-lg-center"
      >


        <!-- QUIENES SOMOS -->

        <li class="nav-item">
          <a class="nav-link" href="/quienes-somos">
            Quiénes somos
          </a>
        </li>


        <!-- TRABAJADORES -->

        <li class="nav-item">
          <a class="nav-link" href="/trabajadores">
            Trabajadores
          </a>
        </li>


        <!-- CONTACTO -->

        <li class="nav-item">
          <a class="nav-link" href="/contacto">
            Contacto
          </a>
        </li>



        <!-- ==========================================
             CATEGORIAS
        =========================================== -->

        <li class="nav-item dropdown">

          <a
            class="nav-link dropdown-toggle"
            href="#"
            id="categoriasDropdown"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Categorías
          </a>


          <ul
            class="dropdown-menu dropdown-menu-end"
            aria-labelledby="categoriasDropdown"
          >

            <li>
              <h6 class="dropdown-header">
                Hogar y mantenimiento
              </h6>
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores?oficio=Electricista">
                Electricista
              </a>
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores?oficio=Plomero">
                Plomero
              </a>
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores?oficio=Cerrajero">
                Cerrajero
              </a>
            </li>

            <li>
              <hr class="dropdown-divider">
            </li>

            <li>
              <h6 class="dropdown-header">
                Limpieza y cuidado
              </h6>
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores?oficio=Limpieza%20domestica">
                Limpieza doméstica
              </a>
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores?oficio=Niñera">
                Niñera
              </a>
            </li>

            <li>
              <hr class="dropdown-divider">
            </li>

            <li>
              <a class="dropdown-item" href="/trabajadores">
                Ver todos los servicios
              </a>
            </li>

          </ul>

        </li>



        <!-- ==========================================
             CUENTA
        =========================================== -->

        <% if (sesionActiva) { %>


          <!-- ======================================
               ACCESO DIRECTO A "MIS SERVICIOS" (SOLO CLIENTES)
          ======================================= -->

          <% if (navEsCliente) { %>

            <li class="nav-item">

              <a
                class="nav-link d-flex align-items-center gap-2"
                href="/carrito"
                title="Mis servicios"
              >

                <i class="bi bi-bag-check fs-5"></i>

                <span class="d-lg-none">Mis servicios</span>

                <% if (navTotalCarrito > 0) { %>

                  <span class="badge rounded-pill bg-primary text-dark js-contador-carrito">
                    <%= navTotalCarrito %>
                  </span>

                <% } %>

              </a>

            </li>

          <% } %>



          <!-- ======================================
               USUARIO CON SESION INICIADA
          ======================================= -->

          <li class="nav-item dropdown ms-lg-2">

            <a
              class="nav-link dropdown-toggle d-flex align-items-center gap-2"
              href="#"
              id="cuentaDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >

              <span
                class="rounded-circle bg-primary text-dark fw-bold d-inline-flex align-items-center justify-content-center flex-shrink-0"
                style="width: 30px; height: 30px; font-size: .85rem;"
              >
                <%= navInicial %>
              </span>

              <span class="text-truncate" style="max-width: 150px;">
                <%= usuarioActual.nombre %>
              </span>

            </a>


            <ul
              class="dropdown-menu dropdown-menu-end"
              aria-labelledby="cuentaDropdown"
              style="min-width: 230px;"
            >


              <!-- INFORMACION DE LA CUENTA -->

              <li class="px-3 py-2">

                <div class="fw-bold">
                  <%= usuarioActual.nombre %>
                </div>

                <div class="small text-muted">

                  <% if (usuarioActual.tipoUsuario === 'prestador') { %>

                    Prestador de servicios

                  <% } else { %>

                    Cliente

                  <% } %>

                </div>

              </li>


              <li>
                <hr class="dropdown-divider">
              </li>


              <!-- VER PERFIL -->

              <li>

                <a
                  class="dropdown-item d-flex align-items-center gap-2"
                  href="/perfil"
                >
                  <i class="bi bi-person"></i>
                  Ver perfil
                </a>

              </li>

              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="/historial">
                  <i class="bi bi-clock-history"></i>
                  Historial
                </a>
              </li>

              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="/perfil/privacidad">
                  <i class="bi bi-shield-lock"></i>
                  Privacidad
                </a>
              </li>


              <!-- OPCION SOLO PARA CLIENTES -->

              <% if (navEsCliente) { %>

                <li>

                  <a
                    class="dropdown-item d-flex align-items-center gap-2"
                    href="/carrito"
                  >

                    <i class="bi bi-bag-check"></i>

                    Mis servicios

                    <% if (navTotalCarrito > 0) { %>

                      <span class="badge bg-dark rounded-pill ms-auto js-contador-carrito">
                        <%= navTotalCarrito %>
                      </span>

                    <% } %>

                  </a>

                </li>

              <% } %>


              <!-- SEPARADOR -->

              <li>
                <hr class="dropdown-divider">
              </li>


              <!-- CERRAR SESION -->

              <li>

                <button
                  type="button"
                  id="btnCerrarSesion"
                  class="dropdown-item text-danger d-flex align-items-center gap-2"
                >
                  <i class="bi bi-box-arrow-right"></i>
                  Cerrar sesión
                </button>

              </li>

            </ul>

          </li>


        <% } else { %>


          <!-- ======================================
               USUARIO SIN SESION: botones visibles
               (antes estaban escondidos en un menú)
          ======================================= -->

          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">

            <a class="btn btn-outline-light btn-sm px-3" href="/login">
              <i class="bi bi-box-arrow-in-right me-1"></i>
              Iniciar sesión
            </a>

          </li>

          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">

            <a class="btn btn-primary btn-sm px-3" href="/registro">
              <i class="bi bi-person-plus me-1"></i>
              Crear cuenta
            </a>

          </li>


        <% } %>


      </ul>

    </div>

  </div>

</nav>



<!-- ==========================================
     MARCAR EN NARANJA LA PAGINA ACTUAL
=========================================== -->

<script>

  document.addEventListener('DOMContentLoaded', function () {

    const rutaActual =
      window.location.pathname.replace(/\/+$/, '') || '/';

    document
      .querySelectorAll('#navbarNav .navbar-nav > .nav-item > a.nav-link[href]')
      .forEach(function (enlace) {

        const href = enlace.getAttribute('href');

        if (!href || href === '#') {
          return;
        }

        const rutaEnlace =
          href.split('?')[0].replace(/\/+$/, '') || '/';

        const coincide =
          rutaEnlace !== '/' &&
          (rutaActual === rutaEnlace ||
            rutaActual.startsWith(rutaEnlace + '/'));

        if (coincide) {
          enlace.classList.add('active');
          enlace.setAttribute('aria-current', 'page');
        }

      });

  });

</script>



<!-- ==========================================
     CERRAR SESION (misma logica de antes)
=========================================== -->

<% if (sesionActiva) { %>


<script>

  document.addEventListener('DOMContentLoaded', function () {

    const botonCerrarSesion =
      document.getElementById('btnCerrarSesion');

    if (!botonCerrarSesion) {
      return;
    }

    botonCerrarSesion.addEventListener('click', async function () {

      const confirmar =
        confirm('¿Deseas cerrar tu sesión?');

      if (!confirmar) {
        return;
      }

      try {

        // Deshabilitamos el botón para evitar múltiples clics.

        botonCerrarSesion.disabled = true;

        botonCerrarSesion.innerHTML = `
          <span
            class="spinner-border spinner-border-sm"
            aria-hidden="true"
          ></span>

          Cerrando sesión...
        `;


        // PETICION AL BACKEND

        const respuesta = await fetch('/api/auth/logout', {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          }

        });

        const datos = await respuesta.json();


        // ERROR

        if (!respuesta.ok) {

          alert(datos.mensaje || 'No se pudo cerrar la sesión.');

          botonCerrarSesion.disabled = false;

          botonCerrarSesion.innerHTML = `
            <i class="bi bi-box-arrow-right"></i>
            Cerrar sesión
          `;

          return;

        }


        // SESION CERRADA

        window.location.href = '/';

      } catch (error) {

        console.error('Error al cerrar sesión:', error);

        alert('Ocurrió un error al cerrar la sesión.');

        botonCerrarSesion.disabled = false;

        botonCerrarSesion.innerHTML = `
          <i class="bi bi-box-arrow-right"></i>
          Cerrar sesión
        `;

      }

    });

  });

</script>


<% } %>
