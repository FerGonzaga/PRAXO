<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= titulo %> - Encuentra tu Servicio
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Fuente Montserrat de Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">

  <!-- Tu archivo CSS principal -->
  <link rel="stylesheet" href="/css/custom.css">
</head>

<body>

  <%- include('partials/navbar') %>

    <div class="container my-5">
      <div class="row justify-content-center">
        <div class="col-md-7">

          <h1 class="mb-4">Contáctanos</h1>
          <p class="text-muted mb-4">
            ¿Tienes dudas, sugerencias o algún problema con la plataforma?
            Escríbenos y te responderemos lo antes posible.
          </p>

          <!-- Formulario funcional con EmailJS: envia el mensaje a tu Gmail -->
          <form id="formContacto">
            <div class="mb-3">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" name="nombre" class="form-control" id="nombre" placeholder="Tu nombre" required>
            </div>

            <div class="mb-3">
              <label for="correo" class="form-label">Correo electrónico</label>
              <input type="email" name="correo" class="form-control" id="correo" placeholder="nombre@correo.com"
                required>
            </div>

            <div class="mb-3">
              <label for="mensaje" class="form-label">Mensaje</label>
              <textarea name="mensaje" class="form-control" id="mensaje" rows="4" placeholder="Escribe tu mensaje..."
                required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Enviar mensaje</button>
          </form>

          <div id="estadoEnvio" class="mt-3"></div>

        </div>
      </div>
    </div>

    <%- include('partials/footer') %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>

      <!-- EmailJS: envia el formulario de contacto sin necesitar backend -->
      <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
      <script>
        // Reemplaza estos 3 valores con los que te dio tu cuenta de EmailJS
        const EMAILJS_PUBLIC_KEY = 'aCx--zhHhROpHRyVp';
        const EMAILJS_SERVICE_ID = 'service_ignfakp';
        const EMAILJS_TEMPLATE_ID = 'template_7oajuoi';

        emailjs.init(EMAILJS_PUBLIC_KEY);

        const formulario = document.getElementById('formContacto');
        const estadoDiv = document.getElementById('estadoEnvio');

        formulario.addEventListener('submit', function (evento) {
          evento.preventDefault();

          estadoDiv.innerHTML = '<div class="alert alert-secondary">Enviando...</div>';

          emailjs.sendForm(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, formulario)
            .then(() => {
              estadoDiv.innerHTML = '<div class="alert alert-success">Mensaje enviado correctamente.</div>';
              formulario.reset();
            })
            .catch((error) => {
              console.error('Error al enviar:', error);
              estadoDiv.innerHTML = '<div class="alert alert-danger">Ocurrio un error al enviar el mensaje.</div>';
            });
        });
      </script>
</body>

</html>