<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    .stat { border-radius: 14px; }
    .filtro.active { pointer-events: none; }
  </style>
</head>
<body class="bg-light">

  <%- include('partials/navbar') %>

  <%
    const colores = { Pendiente: 'warning text-dark', Cotizada: 'success', Aceptada: 'info text-dark', Rechazada: 'secondary', Pagada: 'primary', Completada: 'dark' };
    const f = tarifas.formatoMXN;
  %>

  <main class="container py-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Historial de servicios</h1>
        <p class="text-muted mb-0"><%= esPrestador ? 'Todos los trabajos que te han solicitado.' : 'Todos los servicios que has solicitado.' %></p>
      </div>
      <a href="<%= esPrestador ? '/inicio-prestador' : '/inicio-cliente' %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver al panel</a>
    </div>

    <!-- RESUMEN -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="stat bg-white shadow-sm p-3 h-100">
          <div class="small text-muted">Servicios</div>
          <div class="fs-4 fw-bold"><%= total %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat bg-white shadow-sm p-3 h-100">
          <div class="small text-muted">Completados</div>
          <div class="fs-4 fw-bold"><%= conteo.Completada %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat bg-white shadow-sm p-3 h-100">
          <div class="small text-muted">En proceso</div>
          <div class="fs-4 fw-bold"><%= conteo.Pendiente + conteo.Cotizada + conteo.Aceptada + conteo.Pagada %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat bg-white shadow-sm p-3 h-100">
          <div class="small text-muted"><%= esPrestador ? 'Total recibido' : 'Total pagado' %></div>
          <div class="fs-5 fw-bold text-success"><%= f(montoMovido) %></div>
        </div>
      </div>
    </div>

    <!-- FILTROS -->
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="/historial" class="btn btn-sm filtro <%= !estadoFiltro ? 'btn-dark active' : 'btn-outline-dark' %>">Todos (<%= total %>)</a>
      <% estados.forEach(e => { %>
        <a href="/historial?estado=<%= e %>" class="btn btn-sm filtro <%= estadoFiltro === e ? 'btn-dark active' : 'btn-outline-dark' %>"><%= e %> (<%= conteo[e] %>)</a>
      <% }) %>
    </div>

    <% if (solicitudes.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-4 shadow-sm">
        <i class="bi bi-inbox fs-1 text-muted"></i>
        <h5 class="mt-3 fw-bold">No hay servicios <%= estadoFiltro ? 'en estado "' + estadoFiltro + '"' : 'todavía' %></h5>
        <% if (!esPrestador) { %>
          <a href="/trabajadores" class="btn btn-dark mt-2">Buscar profesionales</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-responsive bg-white rounded-4 shadow-sm">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Fecha</th>
              <th>Servicio</th>
              <th><%= esPrestador ? 'Cliente' : 'Prestador' %></th>
              <th>Estado</th>
              <th class="text-end"><%= esPrestador ? 'Recibes' : 'Total' %></th>
              <th class="text-end pe-3">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% solicitudes.forEach(s => { %>
              <tr>
                <td class="ps-3 small text-nowrap"><%= new Date(s.fechaCreacion).toLocaleDateString('es-MX') %></td>
                <td>
                  <div class="fw-semibold"><%= s.servicio %></div>
                  <% if (s.calificacion) { %>
                    <small class="text-warning"><% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= s.calificacion ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></small>
                  <% } %>
                </td>
                <td class="small">
                  <%= esPrestador
                        ? (s.clienteId ? s.clienteId.nombre : 'Cliente')
                        : (s.trabajadorId ? s.trabajadorId.nombre + (s.trabajadorId.oficio ? ' · ' + s.trabajadorId.oficio : '') : 'Profesional PRAXO') %>
                </td>
                <td><span class="badge bg-<%= colores[s.estado] || 'primary' %>"><%= s.estado %></span></td>
                <td class="text-end text-nowrap"><%= typeof s.totalMostrar === 'number' && s.totalMostrar > 0 ? f(s.totalMostrar) : '—' %></td>
                <td class="text-end pe-3 text-nowrap">
                  <a href="/chat/<%= s._id %>" class="btn btn-sm btn-outline-dark" title="Abrir chat"><i class="bi bi-chat-dots"></i></a>
                  <% if (s.pago && s.pago.referencia) { %>
                    <a href="/pago/<%= s._id %>/comprobante" target="_blank" class="btn btn-sm btn-outline-primary" title="Comprobante PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
