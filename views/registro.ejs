<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Encuentra tu Servicio</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-7">

        <h1 class="mb-4">Regístrate como profesional</h1>
        <p class="text-muted mb-4">
          Completa tus datos para aparecer en la lista de trabajadores disponibles.
        </p>

        <!-- Formulario visual por ahora, sin logica de guardado todavia -->
        <form>
          <div class="mb-3">
            <label for="nombre" class="form-label">Nombre completo</label>
            <input type="text" class="form-control" id="nombre" placeholder="Tu nombre">
          </div>

          <div class="mb-3">
            <label for="oficio" class="form-label">Oficio</label>
            <select class="form-select" id="oficio">
              <option selected disabled>Selecciona tu oficio</option>
              <option>Electricista</option>
              <option>Plomero</option>
              <option>Cerrajero</option>
              <option>Albañil</option>
              <option>Pintor</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="telefono" class="form-label">Teléfono</label>
            <input type="tel" class="form-control" id="telefono" placeholder="771-123-4567">
          </div>

          <div class="mb-3">
            <label for="ciudad" class="form-label">Ciudad</label>
            <input type="text" class="form-control" id="ciudad" placeholder="Tu ciudad">
          </div>

          <div class="mb-3">
            <label for="descripcion" class="form-label">Descripción de tu servicio</label>
            <textarea class="form-control" id="descripcion" rows="3" placeholder="Cuéntanos sobre tu experiencia..."></textarea>
          </div>

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="disponibleAhora">
            <label class="form-check-label" for="disponibleAhora">
              Estoy disponible ahora mismo
            </label>
          </div>

          <button type="submit" class="btn btn-primary">Registrarme</button>
        </form>

      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
