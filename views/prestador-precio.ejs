<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>

<body>

  <%- include('partials/navbar') %>

  <%
    const formatoMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });
    const etiquetasUnidad = { servicio: 'por servicio', hora: 'por hora', dia: 'por día' };
    const tienePrecio = typeof trabajador.precioBase === 'number' && trabajador.precioBase > 0;
    const unidadActual = trabajador.unidadPrecio || 'servicio';
  %>

  <main class="container py-5">

    <div class="row justify-content-center">

      <div class="col-lg-8">

        <a href="/inicio-prestador" class="small text-decoration-none">
          <i class="bi bi-arrow-left"></i> Volver a mi panel
        </a>

        <h1 class="h3 fw-bold mt-2 mb-1">Mi precio</h1>

        <p class="text-muted mb-4">
          Define tu precio base. Tus clientes lo verán como referencia en tu perfil.
          Puedes cambiarlo cuando lo necesites y cada cambio queda registrado.
        </p>


        <!-- ===================== FORMULARIO ===================== -->

        <div class="card border-0 shadow-sm mb-4">

          <div class="card-body p-4">

            <div id="mensajePrecio" class="alert d-none" role="alert"></div>

            <form id="formPrecio" novalidate>

              <div class="row g-3 mb-3">

                <div class="col-md-6">

                  <label for="precio" class="form-label fw-semibold">
                    Precio base
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input
                      type="number"
                      class="form-control"
                      id="precio"
                      name="precio"
                      min="1"
                      max="1000000"
                      step="0.01"
                      inputmode="decimal"
                      placeholder="Ej. 350"
                      value="<%= tienePrecio ? trabajador.precioBase : '' %>"
                    >
                    <span class="input-group-text">MXN</span>
                  </div>

                </div>

                <div class="col-md-6">

                  <label for="unidad" class="form-label fw-semibold">
                    Se cobra
                  </label>

                  <select class="form-select" id="unidad" name="unidad">
                    <option value="servicio" <%= unidadActual === 'servicio' ? 'selected' : '' %>>Por servicio</option>
                    <option value="hora" <%= unidadActual === 'hora' ? 'selected' : '' %>>Por hora</option>
                    <option value="dia" <%= unidadActual === 'dia' ? 'selected' : '' %>>Por día</option>
                  </select>

                </div>

              </div>


              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="sinPrecio" <%= tienePrecio ? '' : 'checked' %>>
                <label class="form-check-label" for="sinPrecio">
                  Prefiero cotizar cada trabajo (sin precio base)
                </label>
              </div>


              <div class="mb-3">

                <label for="nota" class="form-label fw-semibold">
                  Nota para el cliente <span class="text-muted fw-normal">(opcional)</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="nota"
                  name="nota"
                  maxlength="140"
                  placeholder="Ej. No incluye materiales"
                  value="<%= trabajador.precioNota || '' %>"
                >

              </div>


              <div class="mb-4">

                <label for="motivo" class="form-label fw-semibold">
                  Motivo del cambio <span class="text-muted fw-normal">(opcional)</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="motivo"
                  name="motivo"
                  maxlength="140"
                  placeholder="Ej. Aumentó el costo de los materiales"
                >

                <div class="form-text">
                  Se guarda en tu historial para que recuerdes por qué cambió.
                </div>

              </div>


              <!-- VISTA PREVIA -->

              <div class="p-3 rounded-3 bg-light mb-4">

                <div class="small text-muted mb-1">Así lo verán los clientes:</div>

                <div id="vistaPrevia" class="fs-5"></div>

                <div id="vistaPreviaNota" class="small text-muted"></div>

              </div>


              <button type="submit" id="btnGuardarPrecio" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>
                Guardar precio
              </button>

            </form>

          </div>

        </div>


        <!-- ===================== HISTORIAL ===================== -->

        <div class="card border-0 shadow-sm">

          <div class="card-body p-4">

            <h2 class="h5 mb-3">Historial de cambios</h2>

            <% if (!historial || historial.length === 0) { %>

              <p class="text-muted small mb-0">
                Todavía no has registrado cambios de precio.
              </p>

            <% } else { %>

              <ul class="list-group list-group-flush">

                <% historial.forEach((cambio) => { %>

                  <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-3">

                    <div>

                      <strong>
                        <%= typeof cambio.precio === 'number'
                              ? formatoMoneda.format(cambio.precio)
                              : 'Sin precio base (a cotizar)' %>
                      </strong>

                      <% if (typeof cambio.precio === 'number') { %>
                        <span class="text-muted small">
                          <%= etiquetasUnidad[cambio.unidad] || '' %>
                        </span>
                      <% } %>

                      <div class="small text-muted">
                        <%= cambio.motivo %>
                      </div>

                    </div>

                    <div class="small text-muted text-nowrap">
                      <%= new Date(cambio.fecha).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' }) %>
                    </div>

                  </li>

                <% }) %>

              </ul>

            <% } %>

          </div>

        </div>

      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>

    (function () {

      const formulario = document.getElementById('formPrecio');
      const campoPrecio = document.getElementById('precio');
      const campoUnidad = document.getElementById('unidad');
      const campoSinPrecio = document.getElementById('sinPrecio');
      const campoNota = document.getElementById('nota');
      const campoMotivo = document.getElementById('motivo');
      const vistaPrevia = document.getElementById('vistaPrevia');
      const vistaPreviaNota = document.getElementById('vistaPreviaNota');
      const aviso = document.getElementById('mensajePrecio');
      const boton = document.getElementById('btnGuardarPrecio');

      const etiquetas = { servicio: 'por servicio', hora: 'por hora', dia: 'por día' };
      const formato = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

      function mostrarAviso(texto, tipo) {
        aviso.textContent = texto;
        aviso.className = 'alert alert-' + tipo;
      }

      // Si elige "cotizar cada trabajo", el campo de precio se desactiva
      function sincronizarCampos() {
        campoPrecio.disabled = campoSinPrecio.checked;
        campoUnidad.disabled = campoSinPrecio.checked;
      }

      function actualizarVistaPrevia() {

        const valor = Number(campoPrecio.value);

        const hayPrecio =
          !campoSinPrecio.checked &&
          campoPrecio.value !== '' &&
          Number.isFinite(valor) &&
          valor > 0;

        if (hayPrecio) {
          vistaPrevia.innerHTML =
            '<span class="text-muted small">Desde</span> <strong>' +
            formato.format(valor) +
            '</strong> <span class="text-muted small">' +
            etiquetas[campoUnidad.value] +
            '</span>';
        } else {
          vistaPrevia.innerHTML =
            '<span class="text-muted small">Precio a cotizar</span>';
        }

        // textContent (no innerHTML) porque la nota la escribe el usuario
        vistaPreviaNota.textContent = campoNota.value.trim();
      }

      [campoPrecio, campoUnidad, campoSinPrecio, campoNota].forEach(function (campo) {
        campo.addEventListener('input', function () {
          sincronizarCampos();
          actualizarVistaPrevia();
        });
        campo.addEventListener('change', function () {
          sincronizarCampos();
          actualizarVistaPrevia();
        });
      });

      sincronizarCampos();
      actualizarVistaPrevia();

      formulario.addEventListener('submit', async function (evento) {

        evento.preventDefault();

        boton.disabled = true;

        try {

          const respuesta = await fetch('/prestador/precio', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              precio: campoPrecio.value,
              unidad: campoUnidad.value,
              sinPrecio: campoSinPrecio.checked,
              nota: campoNota.value,
              motivo: campoMotivo.value
            })
          });

          const datos = await respuesta.json();

          if (!respuesta.ok) {
            mostrarAviso(datos.mensaje || 'No se pudo guardar el precio.', 'danger');
            boton.disabled = false;
            return;
          }

          mostrarAviso(datos.mensaje, 'success');

          // Se recarga para que el historial muestre el cambio recien guardado
          setTimeout(function () {
            window.location.reload();
          }, 900);

        } catch (error) {

          console.error('Error al guardar el precio:', error);
          mostrarAviso('No se pudo conectar con el servidor.', 'danger');
          boton.disabled = false;

        }

      });

    })();

  </script>

</body>

</html>
