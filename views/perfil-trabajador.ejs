<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  
  <style>
    body { background-color: #f6f7f9; }
    .perfil-header {
      background-color: white;
      border-radius: 20px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      margin-bottom: 30px;
    }
    .perfil-portada {
      height: 150px;
      background: linear-gradient(135deg, #212529 0%, #495057 100%);
    }
    .perfil-foto-container {
      margin-top: -75px;
      padding: 0 30px;
      display: flex;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 20px;
    }
    @media (max-width: 768px) {
      .perfil-foto-container {
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: -60px;
      }
    }
    .perfil-foto {
      width: 150px;
      height: 150px;
      object-fit: cover;
      border-radius: 50%;
      border: 5px solid white;
      background-color: white;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .calificacion-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 50px;
      background-color: #fff3cd;
      color: #664d03;
      font-weight: 600;
      font-size: 14px;
    }
    .info-card {
      background-color: white;
      border-radius: 15px;
      padding: 25px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
      height: 100%;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- VARIABLES DE SESIÓN -->
  <%
    const sesionIniciada = typeof usuarioAutenticado !== 'undefined' && usuarioAutenticado && typeof usuarioActual !== 'undefined' && usuarioActual;
    const esCliente = sesionIniciada && usuarioActual.tipoUsuario === 'cliente';
    const esPrestador = sesionIniciada && usuarioActual.tipoUsuario === 'prestador';
  %>

  <main class="container py-5">
    
    <!-- HEADER DEL PERFIL -->
    <div class="perfil-header">
      <div class="perfil-portada"></div>
      
      <div class="perfil-foto-container">
        <img 
          src="<%= trabajador.fotoUrl ? trabajador.fotoUrl.replace(/\\\\/g, '/') : '/assets/img/trabajadores/' + trabajador.nombre.toLowerCase().split(' ')[0] + '.jpg' %>" 
          onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(trabajador.nombre) %>&background=random&size=300';"
          alt="<%= trabajador.nombre %>" 
          class="perfil-foto"
        >
        
        <div class="pb-2">
          <h1 class="fw-bold mb-1"><%= trabajador.nombre %></h1>
          <p class="text-muted mb-2 fs-5">
            <i class="bi bi-tools me-2"></i><%= trabajador.oficio %>
          </p>
          <% if (trabajador.calificacionPromedio !== undefined && trabajador.calificacionPromedio !== null) { %>
            <div class="calificacion-badge">
              <i class="bi bi-star-fill"></i> <%= trabajador.calificacionPromedio %> (Calificación)
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- CONTENIDO DEL PERFIL -->
    <div class="row g-4">
      
      <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y PRECIO -->
      <div class="col-lg-7 col-xl-8">
        <div class="info-card">
          <h4 class="fw-bold mb-4">Sobre mi trabajo</h4>
          
          <p class="text-muted" style="line-height: 1.8; font-size: 1.05rem;">
            <%= trabajador.descripcion || 'Profesional verificado y disponible en PRAXO para brindarte el mejor servicio.' %>
          </p>

          <hr class="my-4">

          <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt-fill text-danger me-2"></i> Zona de cobertura</h5>
          <p class="text-muted fs-5"><%= trabajador.ciudad || 'Ubicación no especificada' %></p>

          <!-- ========================================== -->
          <!-- 🟢 FASE 2: TARIFA DE REFERENCIA DINÁMICA -->
          <!-- ========================================== -->
          <% if (trabajador.conceptoPrecio && trabajador.tarifaPrecio > 0) { %>
            <div class="mt-4 p-3 rounded" style="background-color: #e8f4fd; border-left: 4px solid #0d6efd;">
              <div class="d-flex align-items-center">
                <i class="bi bi-tags fs-4 text-primary me-3"></i>
                <div>
                  <h6 class="mb-0 fw-bold text-dark">Tarifa de referencia</h6>
                  <p class="mb-0 text-muted small">
                    <%= trabajador.conceptoPrecio %>: <span class="fw-bold text-dark fs-5">$<%= trabajador.tarifaPrecio %> MXN</span>
                  </p>
                </div>
              </div>
            </div>
          <% } %>

        </div>
      </div>

      <!-- COLUMNA DERECHA: ACCIÓN DE CONTRATACIÓN -->
      <div class="col-lg-5 col-xl-4">
        <div class="info-card d-flex flex-column justify-content-center text-center">
          
          <div class="mb-4">
            <i class="bi bi-shield-check text-success" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-2">Contrata seguro</h4>
            <p class="text-muted small">Acuerda los detalles del servicio y el precio directamente con el profesional mediante PRAXO.</p>
          </div>

          <!-- BOTONES -->
          <% if (esCliente) { %>
            <button type="button" class="btn btn-dark btn-lg w-100 mb-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#contratarModal">
              <i class="bi bi-calendar-check me-2"></i> Solicitar servicio
            </button>
          <% } else if (!sesionIniciada) { %>
            <a href="/login" class="btn btn-dark btn-lg w-100 mb-3 fw-bold shadow-sm">
              <i class="bi bi-box-arrow-in-right me-2"></i> Inicia sesión para contratar
            </a>
          <% } else if (esPrestador) { %>
             <div class="alert alert-secondary text-center small">
               <i class="bi bi-info-circle me-1"></i> Estás navegando como prestador.
             </div>
          <% } %>

          <a href="/trabajadores" class="btn btn-outline-secondary w-100">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
          </a>

        </div>
      </div>

    </div>

  </main>

  <!-- ========================================== -->
  <!-- MODAL DE CONTRATACIÓN (IGUAL AL DE CARRITO)-->
  <!-- ========================================== -->
  <% if (esCliente) { %>
    <div class="modal fade" id="contratarModal" tabindex="-1" aria-labelledby="contratarModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          
          <div class="modal-header bg-light">
            <div>
              <h5 class="modal-title fw-bold" id="contratarModalLabel">Solicitar servicio</h5>
              <small class="text-muted">Completa los datos para <%= trabajador.nombre %></small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>

          <form action="/carrito/agregar" method="POST" enctype="multipart/form-data">
            <div class="modal-body p-4">
              
              <input type="hidden" name="trabajadorId" value="<%= trabajador._id %>">

              <!-- FILA 1: FECHA Y HORA -->
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="fecha" class="form-label fw-semibold"><i class="bi bi-calendar-event me-1"></i> Fecha del servicio <span class="text-danger">*</span></label>
                  <input type="date" id="fecha" name="fecha" class="form-control fecha-servicio" required>
                </div>
                <div class="col-md-6">
                  <label for="hora" class="form-label fw-semibold"><i class="bi bi-clock me-1"></i> Hora <span class="text-danger">*</span></label>
                  <input type="time" id="hora" name="hora" class="form-control" required>
                </div>
              </div>

              <!-- FILA 2: URGENCIA Y FOTO -->
              <div class="row g-3 mb-3 border-top pt-3 mt-1">
                <div class="col-md-6">
                  <label for="urgencia" class="form-label fw-semibold text-primary"><i class="bi bi-exclamation-circle me-1"></i> Nivel de Urgencia</label>
                  <select class="form-select" id="urgencia" name="urgencia">
                    <option value="Programado" selected>Servicio Programado (Normal)</option>
                    <option value="Urgencia">¡Es una Urgencia/Emergencia!</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="imagenEvidencia" class="form-label fw-semibold text-primary"><i class="bi bi-camera me-1"></i> Foto de evidencia (Opcional)</label>
                  <input type="file" class="form-control" id="imagenEvidencia" name="imagenEvidencia" accept="image/jpeg, image/png, image/jpg">
                  <div class="form-text small">Sube una foto para que el profesional vea el trabajo.</div>
                </div>
              </div>

              <!-- UBICACION -->
              <div class="mb-3">
                <label for="ubicacion" class="form-label fw-semibold"><i class="bi bi-geo-alt me-1"></i> Dirección General <span class="text-danger">*</span></label>
                <input type="text" id="ubicacion" name="ubicacion" class="form-control" placeholder="Ej. Col. Centro, Calle Morelos #123" maxlength="150" required>
              </div>

              <!-- REFERENCIAS -->
              <div class="mb-3 border-bottom pb-3">
                <label for="referenciasUbicacion" class="form-label fw-semibold text-primary"><i class="bi bi-signpost-split me-1"></i> Referencias de ubicación (Opcional)</label>
                <input type="text" id="referenciasUbicacion" name="referenciasUbicacion" class="form-control" placeholder="Ej. Casa de dos pisos frente a la papelería azul." maxlength="250">
              </div>

              <!-- DESCRIPCION -->
              <div class="mb-3 pt-2">
                <label for="descripcion" class="form-label fw-semibold"><i class="bi bi-chat-left-text me-1"></i> Describe lo que necesitas <span class="text-danger">*</span></label>
                <textarea id="descripcion" name="descripcion" class="form-control" rows="3" maxlength="500" placeholder="Ej. Necesito reparar una fuga debajo del fregadero de la cocina..." required></textarea>
              </div>

              <!-- SOLICITAR COTIZACION -->
              <div class="form-check bg-light p-3 rounded border border-primary-subtle mt-4">
                <input class="form-check-input ms-1" type="checkbox" id="requiereCotizacion" name="requiereCotizacion">
                <label class="form-check-label fw-bold ms-4 text-dark" for="requiereCotizacion">
                  <i class="bi bi-cash-coin text-success me-1"></i> Solicitar cotización antes del servicio
                </label>
                <div class="form-text ms-4 small">El profesional evaluará tu solicitud y te indicará el costo aproximado.</div>
              </div>

            </div>

            <!-- BOTONES DEL MODAL -->
            <div class="modal-footer bg-light">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-dark">
                <i class="bi bi-bag-plus me-1"></i> Agregar a mis servicios
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- SCRIPT DE FECHAS -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const hoy = new Date();
        const año = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, '0');
        const dia = String(hoy.getDate()).padStart(2, '0');
        const fechaActual = `${año}-${mes}-${dia}`;

        const camposFecha = document.querySelectorAll('.fecha-servicio');
        camposFecha.forEach(function (campo) {
          campo.min = fechaActual;
        });
      });
    </script>
  <% } %>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

  <!-- BOOTSTRAP JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>