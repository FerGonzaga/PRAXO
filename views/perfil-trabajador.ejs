<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= titulo %> - PRAXO</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/custom.css"
  >

  <style>

    body {
      background-color: #f5f6f8;
    }

    .perfil-container {
      max-width: 950px;
      margin: 45px auto;
    }

    .perfil-card {
      background: white;
      border-radius: 22px;
      overflow: hidden;
      border: none;
      box-shadow: 0 5px 25px rgba(0, 0, 0, .07);
    }

    .perfil-portada {
      height: 160px;
      background: #212529;
    }

    .perfil-contenido {
      padding: 0 35px 35px;
    }

    .perfil-foto {
      width: 135px;
      height: 135px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid white;
      margin-top: -68px;
      background: #fff;
    }

    .oficio {
      color: #6c757d;
      font-size: 17px;
    }

    .calificacion {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #fff3cd;
      color: #664d03;
      padding: 7px 12px;
      border-radius: 30px;
      font-weight: 600;
    }

    .info-box {
      background: #f8f9fa;
      border-radius: 14px;
      padding: 18px;
      height: 100%;
    }

    .info-icono {
      font-size: 22px;
      margin-bottom: 7px;
    }

    .descripcion {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 14px;
    }

    @media(max-width: 576px) {

      .perfil-contenido {
        padding: 0 20px 25px;
      }

      .perfil-principal {
        text-align: center;
      }

    }

  </style>

</head>

<body>


  <%- include('partials/navbar') %>


  <main class="container">

    <div class="perfil-container">

      <section class="perfil-card">


        <!-- PORTADA -->

        <div class="perfil-portada"></div>


        <div class="perfil-contenido">


          <!-- FOTO -->

          <div class="perfil-principal">

            <img
              src="<%= trabajador.fotoUrl
                ? trabajador.fotoUrl.replace(/\\/g, '/')
                : '/assets/img/trabajadores/' +
                  trabajador.nombre.toLowerCase().split(' ')[0] +
                  '.jpg'
              %>"

              onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(trabajador.nombre) %>&background=random&size=300';"

              class="perfil-foto"

              alt="<%= trabajador.nombre %>"
            >


            <div
              class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mt-3"
            >

              <div>

                <h1 class="h3 fw-bold mb-1">

                  <%= trabajador.nombre %>

                </h1>


                <div class="oficio">

                  <i class="bi bi-tools me-1"></i>

                  <%= trabajador.oficio %>

                </div>

              </div>


              <div>

                <span class="calificacion">

                  <i class="bi bi-star-fill"></i>

                  <%= trabajador.calificacionPromedio ?? 0 %>

                </span>

              </div>

            </div>

          </div>


          <hr class="my-4">


          <!-- INFORMACION -->

          <div class="row g-3">


            <!-- CIUDAD -->

            <div class="col-md-6">

              <div class="info-box">

                <div class="info-icono">

                  <i class="bi bi-geo-alt"></i>

                </div>

                <small class="text-muted">

                  Ubicación

                </small>

                <div class="fw-semibold mt-1">

                  <%= trabajador.ciudad || 'No especificada' %>

                </div>

              </div>

            </div>


            <!-- TELEFONO -->

            <div class="col-md-6">

              <div class="info-box">

                <div class="info-icono">

                  <i class="bi bi-telephone"></i>

                </div>

                <small class="text-muted">

                  Teléfono

                </small>

                <div class="fw-semibold mt-1">

                  <%= trabajador.telefono || 'No especificado' %>

                </div>

              </div>

            </div>

          </div>


          <!-- DESCRIPCION -->

          <div class="mt-4">

            <h2 class="h5 fw-bold">

              Acerca del profesional

            </h2>

            <div class="descripcion mt-3">

              <%= trabajador.descripcion ||
                'Este profesional todavía no ha agregado una descripción.' %>

            </div>

          </div>


          <!-- ACCIONES -->

          <div class="d-flex flex-wrap gap-2 mt-4">


            <a
              href="/trabajadores"
              class="btn btn-outline-dark"
            >

              <i class="bi bi-arrow-left me-1"></i>

              Volver a profesionales

            </a>


            <!-- CLIENTE CON SESION -->

            <% if (
              typeof usuarioAutenticado !== 'undefined' &&
              usuarioAutenticado &&
              usuarioActual &&
              usuarioActual.tipoUsuario === 'cliente'
            ) { %>

              <a
                href="/trabajadores"
                class="btn btn-dark"
              >

                <i class="bi bi-calendar-check me-1"></i>

                Contratar servicio

              </a>

            <% } else if (
              typeof usuarioAutenticado === 'undefined' ||
              !usuarioAutenticado
            ) { %>

              <a
                href="/login"
                class="btn btn-dark"
              >

                <i class="bi bi-box-arrow-in-right me-1"></i>

                Inicia sesión para contratar

              </a>

            <% } %>


          </div>


        </div>

      </section>

    </div>

  </main>


  <%- include('partials/footer') %>


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

  <script src="/js/main.js"></script>


</body>

</html>