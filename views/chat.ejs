<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - PRAXO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    .estrellas { display: inline-flex; flex-direction: row-reverse; gap: 4px; }
    .estrellas input { display: none; }
    .estrellas label { font-size: 2.2rem; color: #d0d4d9; cursor: pointer; transition: color .15s, transform .15s; }
    .estrellas label:hover, .estrellas label:hover ~ label,
    .estrellas input:checked ~ label { color: #ffc107; }
    .estrellas label:hover { transform: scale(1.15); }
    .estrellas-fijas { color: #ffc107; font-size: 1.3rem; }
    body { background-color: #f4f7f6; }
    .chat-container { height: 60vh; overflow-y: auto; background-color: #ffffff; border-radius: 15px; padding: 20px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.02); }
    .burbuja { max-width: 75%; padding: 12px 18px; border-radius: 20px; position: relative; margin-bottom: 15px; }
    .burbuja-mia { background-color: #0d6efd; color: white; border-bottom-right-radius: 4px; margin-left: auto; }
    .burbuja-otro { background-color: #f1f3f5; color: #212529; border-bottom-left-radius: 4px; }
    .fecha-msg { font-size: 0.7rem; opacity: 0.8; display: block; margin-top: 5px; text-align: right; }
    .cotizacion-box { border-left: 5px solid #198754; background-color: #eafbf3; border-radius: 10px; }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="container py-4">
    
    <div class="row justify-content-center">
      <div class="col-lg-10">
        
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="fw-bold mb-0"><i class="bi bi-chat-text text-primary me-2"></i> Sala de Acuerdos</h3>
          <% if (usuarioLogueado.tipoUsuario === 'prestador') { %>
            <a href="/prestador/solicitudes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver a Bandeja</a>
          <% } else { %>
            <a href="/inicio-cliente" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver al Panel</a>
          <% } %>
        </div>

        <% const d = tarifas.desgloseDeSolicitud(solicitud); %>
        <% const rolVista = usuarioLogueado.tipoUsuario === 'prestador' ? 'prestador' : 'cliente'; %>

        <!-- ZONA DE COTIZACIÓN -->
        <% if (solicitud.estado === 'Cotizada') { %>
          <div class="cotizacion-box p-4 mb-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h5 class="fw-bold text-success mb-1"><i class="bi bi-file-earmark-check-fill me-1"></i> Cotización Oficial del Prestador</h5>
                <p class="mb-2 text-dark"><strong>Mensaje:</strong> <%= solicitud.mensajeCotizacion %></p>
                <%- include('partials/desglose', { d, rol: rolVista }) %>
              </div>
              
              <!-- Si el que mira es el cliente, mostramos los botones de ACEPTAR / RECHAZAR -->
              <% if (usuarioLogueado.tipoUsuario === 'cliente') { %>
                <div class="text-end">
                  <span class="badge bg-warning text-dark mb-2">Esperando tu confirmación</span>
                  <form action="/chat/<%= solicitud._id %>/aceptar" method="POST" class="mt-1"
                        onsubmit="this.querySelector('button').disabled = true; return confirm('¿Aceptar la cotización? Total a pagar: <%= tarifas.formatoMXN(d.total) %> MXN');">
                    <button type="submit" class="btn btn-success fw-bold px-4"><i class="bi bi-credit-card me-1"></i> Aceptar y Pagar</button>
                  </form>
                  <form action="/chat/<%= solicitud._id %>/rechazar" method="POST" class="mt-2"
                        onsubmit="return confirm('¿Seguro que quieres rechazar esta cotización?');">
                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Rechazar cotización</button>
                  </form>
                </div>
              <% } else { %>
                <div class="text-end">
                  <span class="badge bg-secondary">Esperando confirmación del cliente</span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- COTIZACIÓN ACEPTADA: pendiente de pago -->
        <% if (solicitud.estado === 'Aceptada') { %>
          <div class="cotizacion-box p-4 mb-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
              <div>
                <h5 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Cotización aceptada</h5>
                <%- include('partials/desglose', { d, rol: rolVista }) %>
              </div>
              <div class="text-end">
                <% if (usuarioLogueado.tipoUsuario === 'cliente') { %>
                  <a href="/pago/<%= solicitud._id %>" class="btn btn-success fw-bold px-4"><i class="bi bi-lock-fill me-1"></i> Pagar ahora</a>
                <% } else { %>
                  <span class="badge bg-info text-dark">El cliente aceptó. Esperando pago.</span>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>

        <!-- SERVICIO PAGADO: comprobante -->
        <% if ((solicitud.estado === 'Pagada' || solicitud.estado === 'Completada') && solicitud.pago && solicitud.pago.referencia) { %>
          <div class="p-4 mb-4 shadow-sm rounded-3 bg-white border-start border-5 border-primary">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
              <div>
                <h5 class="fw-bold text-primary mb-2"><i class="bi bi-receipt-cutoff me-1"></i> Comprobante de pago</h5>
                <p class="mb-1"><strong>Total pagado:</strong> <%= tarifas.formatoMXN(solicitud.pago.monto) %> <%= solicitud.pago.moneda %></p>
                <% if (rolVista === 'prestador' && typeof solicitud.pago.precioPrestador === 'number') { %>
                  <p class="mb-1"><strong>Tú recibes:</strong> <%= tarifas.formatoMXN(solicitud.pago.precioPrestador) %> MXN</p>
                <% } %>
                <p class="mb-1"><strong>Método:</strong> <%= solicitud.pago.marca %> •••• <%= solicitud.pago.ultimos4 %> <span class="badge bg-light text-muted border">simulado</span></p>
                <p class="mb-1"><strong>Referencia:</strong> <code><%= solicitud.pago.referencia %></code></p>
                <p class="mb-0 small text-muted"><%= new Date(solicitud.pago.fecha).toLocaleString('es-MX') %></p>
              </div>
              <div class="text-end">
                <% if (usuarioLogueado.tipoUsuario === 'prestador') { %>
                  <span class="badge bg-success">Pago recibido. ¡Puedes realizar el trabajo!</span>
                <% } else { %>
                  <span class="badge bg-primary">Pagado. El prestador ya fue notificado.</span>
                <% } %>
                <div class="mt-3 d-flex flex-column gap-2">
                  <a href="/pago/<%= solicitud._id %>/comprobante" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Ver comprobante (PDF)
                  </a>
                  <a href="/pago/<%= solicitud._id %>/comprobante?descargar=1" class="btn btn-primary btn-sm">
                    <i class="bi bi-download me-1"></i> Descargar ticket
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <!-- PAGADA: el prestador marca el trabajo como terminado -->
        <% if (solicitud.estado === 'Pagada') { %>
          <div class="p-3 mb-4 rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2">
            <% if (usuarioLogueado.tipoUsuario === 'prestador') { %>
              <span><i class="bi bi-tools text-primary me-1"></i> ¿Ya terminaste el trabajo?</span>
              <form action="/chat/<%= solicitud._id %>/completar" method="POST"
                    onsubmit="return confirm('¿Confirmas que el trabajo está terminado?');">
                <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check2-all me-1"></i> Marcar como completado</button>
              </form>
            <% } else { %>
              <span class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Servicio en curso. Cuando el prestador lo marque como terminado podrás calificarlo.</span>
            <% } %>
          </div>
        <% } %>

        <!-- COMPLETADA: reseña -->
        <% if (solicitud.estado === 'Completada') { %>
          <div class="p-4 mb-4 rounded-3 bg-white shadow-sm border-start border-5 border-warning">
            <% if (resena) { %>
              <h5 class="fw-bold mb-2"><i class="bi bi-star-fill text-warning me-1"></i> Reseña del servicio</h5>
              <div class="estrellas-fijas mb-1">
                <% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= resena.calificacion ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                <span class="text-dark fs-6 ms-2"><%= resena.calificacion %>/5</span>
              </div>
              <% if (resena.comentario) { %><p class="mb-0 fst-italic">"<%= resena.comentario %>"</p><% } %>
            <% } else if (usuarioLogueado.tipoUsuario === 'cliente') { %>
              <h5 class="fw-bold mb-1"><i class="bi bi-patch-check-fill text-success me-1"></i> ¡Servicio completado!</h5>
              <p class="text-muted mb-3">¿Cómo fue tu experiencia? Tu opinión ayuda a otros clientes.</p>
              <form action="/chat/<%= solicitud._id %>/resena" method="POST" id="formResena">
                <div class="estrellas mb-1">
                  <% for (let i = 5; i >= 1; i--) { %>
                    <input type="radio" name="calificacion" id="estrella<%= i %>" value="<%= i %>" required>
                    <label for="estrella<%= i %>" title="<%= i %> estrella<%= i > 1 ? 's' : '' %>"><i class="bi bi-star-fill"></i></label>
                  <% } %>
                </div>
                <div class="small text-muted mb-3" id="textoEstrellas">Selecciona una calificación</div>
                <textarea name="comentario" class="form-control mb-3" rows="3" maxlength="500" placeholder="Cuéntanos cómo te fue (opcional)"></textarea>
                <button type="submit" class="btn btn-warning fw-bold px-4"><i class="bi bi-send me-1"></i> Enviar reseña</button>
              </form>
            <% } else { %>
              <h5 class="fw-bold mb-1"><i class="bi bi-patch-check-fill text-success me-1"></i> Trabajo completado</h5>
              <p class="text-muted mb-0">Esperando la reseña del cliente.</p>
            <% } %>
          </div>
        <% } %>

        <% if (solicitud.estado === 'Rechazada') { %>
          <div class="alert alert-secondary mb-4"><i class="bi bi-x-circle me-1"></i> La cotización fue rechazada por el cliente.</div>
        <% } %>

        <!-- AVISOS DESPUÉS DE UNA ACCIÓN -->
        <% if (aviso === 'aceptada') { %>
          <div class="alert alert-success alert-dismissible fade show">¡Listo! Aceptaste la cotización. El siguiente paso es el pago.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'rechazada') { %>
          <div class="alert alert-secondary alert-dismissible fade show">Rechazaste la cotización.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'pagada') { %>
          <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check2-circle me-1"></i> ¡Pago realizado con éxito! El prestador ya puede comenzar el trabajo.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'ya-pagada') { %>
          <div class="alert alert-info alert-dismissible fade show">Este servicio ya está pagado.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'no-pagable') { %>
          <div class="alert alert-warning alert-dismissible fade show">Primero debes aceptar la cotización para poder pagar.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'completada') { %>
          <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check2-all me-1"></i> Marcaste el trabajo como completado. El cliente ya puede calificarte.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'no-completable') { %>
          <div class="alert alert-warning alert-dismissible fade show">Solo puedes completar servicios que ya fueron pagados.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'calificada') { %>
          <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-star-fill me-1"></i> ¡Gracias por tu reseña!<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'ya-calificada') { %>
          <div class="alert alert-info alert-dismissible fade show">Este servicio ya fue calificado.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'resena-invalida') { %>
          <div class="alert alert-warning alert-dismissible fade show">Elige de 1 a 5 estrellas.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'no-calificable') { %>
          <div class="alert alert-warning alert-dismissible fade show">Solo puedes calificar servicios completados.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } else if (aviso === 'no-aceptable') { %>
          <div class="alert alert-warning alert-dismissible fade show">Esta cotización ya no puede modificarse (quizá ya fue aceptada o rechazada).<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <!-- ZONA DE CHAT -->
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
            <div>
              <h6 class="mb-0 fw-bold">
                <%= usuarioLogueado.tipoUsuario === 'cliente' ? 'Hablando con el Prestador' : ('Hablando con ' + solicitud.clienteId.nombre) %>
              </h6>
              <small class="opacity-75">Servicio: <%= solicitud.servicio %></small>
            </div>
            <span class="badge bg-light text-dark">Estado: <%= solicitud.estado %></span>
          </div>

          <div class="card-body p-0">
            <!-- Contenedor de mensajes -->
            <div class="chat-container d-flex flex-column" id="cajaMensajes">
              
              <div class="text-center mb-4 mt-2">
                <small class="bg-light text-muted px-3 py-1 rounded-pill border">El servicio ha sido creado. Ya pueden chatear.</small>
              </div>

              <% if (mensajes && mensajes.length > 0) { %>
                <% mensajes.forEach(msg => { %>
                  <% const esMio = msg.emisorId._id.toString() === usuarioLogueado.id.toString(); %>
                  
                  <div class="burbuja <%= esMio ? 'burbuja-mia' : 'burbuja-otro' %>">
                    <% if (!esMio) { %>
                      <strong class="small d-block mb-1 text-primary"><%= msg.emisorId.nombre %></strong>
                    <% } %>
                    <%= msg.texto %>
                    <span class="fecha-msg"><%= new Date(msg.fecha).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center mt-5 text-muted opacity-50">
                  <i class="bi bi-chat-dots display-1 d-block mb-3"></i>
                  <p>Aún no hay mensajes. ¡Escribe el primero!</p>
                </div>
              <% } %>
            </div>
          </div>

          <!-- FORMULARIO DE ENVÍO -->
          <div class="card-footer bg-white p-3 border-top">
            <form action="/chat/<%= solicitud._id %>/mensaje" method="POST" class="d-flex gap-2">
              <input type="text" name="texto" class="form-control rounded-pill px-4" placeholder="Escribe un mensaje aquí..." required autocomplete="off">
              <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-send-fill"></i>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-scroll al final del chat cuando carga la página
    document.addEventListener("DOMContentLoaded", function() {
      const caja = document.getElementById("cajaMensajes");
      caja.scrollTop = caja.scrollHeight;

      // Texto que acompaña a las estrellas
      const etiquetas = { 1: 'Muy malo', 2: 'Malo', 3: 'Regular', 4: 'Bueno', 5: '¡Excelente!' };
      document.querySelectorAll('input[name="calificacion"]').forEach(r => {
        r.addEventListener('change', () => {
          document.getElementById('textoEstrellas').textContent = r.value + ' de 5 · ' + etiquetas[r.value];
        });
      });
    });
  </script>
</body>
</html>